#!/bin/sh
STAMP=/etc/osi-rootfs-grow.partitioned
NEEDS_RESIZE=/etc/osi-rootfs-grow-needs-resize
REBOOT_REQUEST=/var/run/osi-rootfs-grow-reboot

# Exit cleanly when partition growth has completed, or while resize2fs is
# pending after a successful partition resize. This avoids repeated repartition
# and reboot cycles if power is lost before the filesystem grow succeeds.
[ -f "$STAMP" ] && exit 0
[ -f "$NEEDS_RESIZE" ] && exit 0

. /usr/libexec/osi-rootfs-grow.sh || exit 1
if ! osi_rootfs_target; then
  logger -t osi-rootfs-grow "unsupported writable filesystem ($ROOT_FSTYPE); automatic growth skipped"
  [ "$ROOT_FSTYPE" = f2fs ] && exit 0
  exit 1
fi
if osi_rootfs_provisioned; then
  logger -t osi-rootfs-grow "provisioned gateway; refusing automatic partition changes"
  exit 0
fi
if ! osi_rootfs_geometry; then
  logger -t osi-rootfs-grow "unsupported root filesystem or partition layout; leaving defaults for retry"
  exit 1
fi
DISK=/dev/mmcblk0
PART=2

command -v parted >/dev/null 2>&1 || {
  logger -t osi-rootfs-grow "parted missing; will retry"
  exit 1
}
command -v resize2fs >/dev/null 2>&1 || {
  logger -t osi-rootfs-grow "resize2fs missing; will retry"
  exit 1
}

if [ "$((PART_START + PART_SECTORS))" -lt "$DISK_SECTORS" ]; then
  logger -t osi-rootfs-grow "resizing $DISK partition $PART in place"
  # Script mode refuses the mounted-partition question. Permit exactly this
  # grow command, with one answer; never feed an unbounded yes process.
  if ! LC_ALL=C parted "$DISK" --align optimal ---pretend-input-tty resizepart "$PART" 100% <<EOF; then
yes
EOF
    logger -t osi-rootfs-grow "parted resizepart failed; will retry"
    exit 1
  fi
fi

# Queue a reboot after S95done establishes fstools READY. Rebooting here in
# S10 can make preinit erase this marker and the defaults whiteouts. The
# volatile request prevents a later resize failure from causing reboot loops.
touch "$REBOOT_REQUEST" && touch "$NEEDS_RESIZE" && sync || {
  logger -t osi-rootfs-grow "pending marker could not be persisted; will retry"
  exit 1
}
logger -t osi-rootfs-grow "filesystem resize pending; growth reboot queued until overlay READY"
exit 0
