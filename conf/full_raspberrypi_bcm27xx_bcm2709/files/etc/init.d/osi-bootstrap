#!/bin/sh /etc/rc.common

START=99

BOOTSTRAP_ROM="/usr/share/node-red/chirpstack-bootstrap.js"
BOOTSTRAP_FALLBACK="/srv/node-red/chirpstack-bootstrap.js"

stamp_valid() {
	[ -f /etc/osi-bootstrap.done ] || return 1
	[ -f /srv/node-red/.chirpstack.env ] || return 1
	grep -q 'CHIRPSTACK_APP_SENSORS=[0-9a-f]\{8\}-' /srv/node-red/.chirpstack.env 2>/dev/null || return 1
	return 0
}

# The OSI_BOOTSTRAP_REVISION a bootstrap script declares. Supported range:
# 1 to 999999, digits only, no leading zero; scripts/verify-bootstrap-revision.js
# enforces the same rule in CI. A copy without the line counts as 0. A value
# outside the range counts as 0 too, with one log line, so the -ge comparison
# below never sees a number the shell cannot compare.
bootstrap_revision() {
	local line revision
	if [ ! -r "$1" ]; then
		logger -t osi-bootstrap "cannot read $1 for OSI_BOOTSTRAP_REVISION; counting it as 0"
		echo 0
		return 0
	fi
	line="$(grep '^const OSI_BOOTSTRAP_REVISION' "$1" 2>/dev/null | head -n 1)"
	if [ -z "$line" ]; then
		echo 0
		return 0
	fi
	revision="$(printf '%s\n' "$line" | sed -n 's/^const OSI_BOOTSTRAP_REVISION = \([0-9][0-9]*\);[[:space:]]*$/\1/p')"
	case "$revision" in
		[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9])
			echo "$revision" ;;
		*)
			logger -t osi-bootstrap "OSI_BOOTSTRAP_REVISION in $1 is not 1 to 999999; counting it as 0"
			echo 0 ;;
	esac
}

# deploy.sh writes the current script to /srv/node-red and leaves the image
# copy alone; a sysupgrade replaces the image copy and keeps /srv. Of the two,
# the higher revision runs, and the deployed copy on a tie: an image from
# before the revision mark counts as 0.
select_bootstrap_script() {
	if [ -f "$BOOTSTRAP_FALLBACK" ] && [ -f "$BOOTSTRAP_ROM" ]; then
		if [ "$(bootstrap_revision "$BOOTSTRAP_FALLBACK")" -ge "$(bootstrap_revision "$BOOTSTRAP_ROM")" ]; then
			echo "$BOOTSTRAP_FALLBACK"
		else
			echo "$BOOTSTRAP_ROM"
		fi
	elif [ -f "$BOOTSTRAP_FALLBACK" ]; then
		echo "$BOOTSTRAP_FALLBACK"
	elif [ -f "$BOOTSTRAP_ROM" ]; then
		echo "$BOOTSTRAP_ROM"
	fi
}

boot() {
	start
}

start() {
	if stamp_valid; then
		return 0
	fi

	local bootstrap_script
	local provisioned_this_boot=0
	bootstrap_script="$(select_bootstrap_script)"

	if [ -z "$bootstrap_script" ]; then
		logger -t osi-bootstrap "bootstrap script not found, will retry next boot"
		return 0
	fi

	logger -t osi-bootstrap "waiting for ChirpStack gRPC..."
	local ready=0
	for i in $(seq 1 24); do
		if curl -sf --max-time 3 http://localhost:8080 2>/dev/null; then
			ready=1
			break
		fi
		sleep 5
	done

	if [ "$ready" = 0 ]; then
		logger -t osi-bootstrap "ChirpStack not ready after 120s, will retry next boot"
		return 0
	fi

	logger -t osi-bootstrap "running $(basename "$bootstrap_script")..."
	# The script writes the ChirpStack API key to .chirpstack.env. An older
	# image's script creates that file with the process umask, so every file it
	# creates here is owner-only.
	if (umask 077 && exec node "$bootstrap_script"); then
		if touch /etc/osi-bootstrap.done; then
			provisioned_this_boot=1
			logger -t osi-bootstrap "bootstrap completed successfully"
		else
			logger -t osi-bootstrap "bootstrap completed but stamp write failed, will retry next boot"
		fi
	else
		logger -t osi-bootstrap "bootstrap failed, will retry next boot"
	fi

	if [ "$provisioned_this_boot" = 1 ]; then
		logger -t osi-bootstrap "requesting coordinated Node-RED restart after bootstrap"
		if ! /etc/init.d/osi-identityd ready; then
			rm -f /etc/osi-bootstrap.done
			logger -t osi-bootstrap "identityd is not ready; bootstrap will retry"
			return 0
		fi
		if /usr/libexec/osi-identityd.sh request-restart chirpstack_bootstrap 60; then
			logger -t osi-bootstrap "Node-RED restart requested after bootstrap"
		else
			rm -f /etc/osi-bootstrap.done
			logger -t osi-bootstrap "Node-RED restart request failed; bootstrap will retry"
			return 0
		fi
	fi
	return 0
}
