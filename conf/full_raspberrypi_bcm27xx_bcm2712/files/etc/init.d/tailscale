#!/bin/sh /etc/rc.common

# Copyright 2020 Google LLC.
# Copyright (C) 2021 CZ.NIC z.s.p.o. (https://www.nic.cz/)
# SPDX-License-Identifier: Apache-2.0

# OSI OS copy of the init file of the tailscale package (1.80.3-r1). It
# differs from the package file in three ways: the cleanup is cut short after
# OSI_CLEANUP_LIMIT seconds, the cleanup does not hold procd's lock on this
# service, and the service starts at 99 instead of 80.

USE_PROCD=1
# ChirpStack, its forwarders, Node-RED and osi-bootstrap also start at 99, and
# procd runs the boot links in name order: S99chirpstack*, S99node-red,
# S99osi-bootstrap, S99sudo, then S99tailscale. The farm services never wait
# for tailscale. Remote access waits for osi-bootstrap, briefly on a
# provisioned gateway: its boot start checks its stamp first (two file tests
# and one grep of a local file) and returns. Only a boot that still
# provisions ChirpStack waits there longer, up to 120 s for ChirpStack and
# then for the bootstrap script.
START=99

# Seconds a cleanup may take. tailscaled repeats the cleanup when it starts,
# so one that is cut short loses nothing.
OSI_CLEANUP_LIMIT=15

# Runs "tailscaled --cleanup" and returns once it has exited, or when
# OSI_CLEANUP_LIMIT seconds have passed. The BusyBox on the image has no
# timeout applet. Only the background shell waits for the cleanup: a process
# that cannot be killed must not keep this script, and with it the boot,
# from moving on. That shell first closes fd 1000, on which procd.sh holds
# this service's lock for the whole init call; a cleanup that outlives its
# kill must not keep later start, stop and restart calls waiting on it.
osi_tailscale_cleanup() {
  osi_dir="$(mktemp -d /tmp/tailscale-cleanup.XXXXXX)" || return 0
  (
    exec 1000>&-
    /usr/sbin/tailscaled --cleanup &
    echo $! >"$osi_dir/pid"
    wait $!
    echo $? >"$osi_dir/status"
  ) &
  osi_runner=$!
  osi_waited=0
  while [ ! -f "$osi_dir/status" ] && [ "$osi_waited" -lt "$OSI_CLEANUP_LIMIT" ]; do
    sleep 1
    osi_waited=$((osi_waited + 1))
  done
  if [ -f "$osi_dir/status" ]; then
    wait "$osi_runner"
    rm -rf "$osi_dir"
    return 0
  fi
  osi_pid="$(cat "$osi_dir/pid" 2>/dev/null)"
  case "$(tr '\000' ' ' <"/proc/$osi_pid/cmdline" 2>/dev/null)" in
    *tailscaled*--cleanup*) kill -9 "$osi_pid" ;;
  esac
  logger -t tailscale "cleanup did not finish in ${OSI_CLEANUP_LIMIT} s; continuing without it"
  return 0
}

start_service() {
  local state_file
  local port
  local std_err std_out

  config_load tailscale
  config_get_bool std_out "settings" log_stdout 1
  config_get_bool std_err "settings" log_stderr 1
  config_get port "settings" port 41641
  config_get state_file "settings" state_file /etc/tailscale/tailscaled.state
  config_get fw_mode "settings" fw_mode nftables

  osi_tailscale_cleanup

  procd_open_instance
  procd_set_param command /usr/sbin/tailscaled

  # Starting with v1.48.1 ENV variable is required to enable use of iptables / nftables.
  # Use nftables by default - can be changed to 'iptables' in tailscale config
  procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"

  # Set the port to listen on for incoming VPN packets.
  # Remote nodes will automatically be informed about the new port number,
  # but you might want to configure this in order to set external firewall
  # settings.
  procd_append_param command --port "$port"
  procd_append_param command --state "$state_file"

  procd_set_param respawn
  procd_set_param stdout "$std_out"
  procd_set_param stderr "$std_err"

  procd_close_instance
}

stop_service() {
  osi_tailscale_cleanup
}
