#!/bin/sh /etc/rc.common

START=90
STOP=
USE_PROCD=0

start() {
  local report rc=0
  report="$(node /usr/share/node-red/osi-db-integrity/index.js 2>&1)" || rc=$?
  [ -z "$report" ] || logger -t osi-db-integrity "$report"
  if [ "$rc" -ne 0 ]; then
    logger -t osi-db-integrity "database recovery check exited $rc"
    return "$rc"
  fi
}
