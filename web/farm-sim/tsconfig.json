{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@osi-demo/*": ["../react-gui/demo/*"],
      "@osi-edge/*": ["../../conf/full_raspberrypi_bcm27xx_bcm2712/files/usr/share/node-red/*"]
    }
  },
  "include": ["src", "art", "scripts", "tests", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["src/phone/**", "tests/unit/phone-*.test.ts"]
}
