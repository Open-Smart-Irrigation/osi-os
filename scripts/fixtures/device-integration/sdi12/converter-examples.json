  {
    "name": "vendor-pdta",
    "description": "Inspect the manual PDTA log payload under declared settings.",
    "evidence": "vendor_example",
    "source": "https://wiki.dragino.com/docs/LoRaWAN-End-Node/io-controllers-sensor-nodes/sdi-12-lb/",
    "transformation": "Manual section 3.7 first PDTA entry: remove log addresses, timestamp and decimal length 18; join hex byte lines unchanged. DATAUP=0, no cuts, no conversion and no EXT settings are interpretation assumptions; FPort 2 is supplied, not captured.",
    "input": {
      "operation": "frame",
      "input": {
        "fport": 2,
        "bytes": [
          12,
          132,
          1,
          241,
          13,
          48,
          43,
          49,
          46,
          48,
          56,
          43,
          50,
          52,
          46,
          54,
          13,
          10
        ],
        "configuration": {
          "dataup": 0,
          "payver": 1,
          "alldatamod": 1,
          "datacut": "none",
          "dataconv": "none",
          "ext": [
            0,
            0,
            0
          ]
        }
      }
    },
    "expected": {
      "ok": true,
      "disposition": "wrapped",
      "text": "0+1.08+24.6\r\n"
    }
  },
