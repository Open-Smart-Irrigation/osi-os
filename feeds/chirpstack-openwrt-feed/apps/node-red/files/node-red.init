#!/bin/sh /etc/rc.common

START=99
STOP=99

USE_PROCD=1
PACKAGE_NAME=node-red

[ -f /usr/libexec/osi-gateway-identity.sh ] && . /usr/libexec/osi-gateway-identity.sh

normalize_runtime_eui() {
    local normalized
    normalized="$(normalize_gateway_eui "$1" 2>/dev/null || true)"
    printf '%s' "$normalized"
}

CHIRPSTACK_ENV_FILE="/srv/node-red/.chirpstack.env"

# osi-os#223. procd's stdout/stderr capture (below, in start_service) puts
# Node-RED's node.error/node.warn output into syslog, but OpenWrt's syslog is
# logd: a RAM ring buffer that a power cycle empties. A boot-node failure that
# only ever reached the ring is gone by the time anyone looks. So also point
# ubox's own log service -- already in the image, nothing new installed -- at a
# bounded file on the persistent /data partition.
#
# The bound is logread's own: `logread -f -F <file> -S <KiB>` renames the file
# to <file>.0 once it passes the size and starts a fresh one, so the worst case
# on disk is two files, 2 * OSI_PERSISTENT_LOG_SIZE_KIB = 4 MiB. Nothing here
# prunes or rotates on a schedule; the size cap is the whole mechanism.
OSI_PERSISTENT_LOG_FILE="/data/log/osi-system.log"
OSI_PERSISTENT_LOG_SIZE_KIB="2048"
# The floor for logd's in-RAM ring. 128 KiB is what OpenWrt's generated
# /etc/config/system carries (config_generate: set log_size='128'), so it is
# the effective ring on a stock gateway and this value must never shrink it.
OSI_LOGD_MIN_BUFFER_KIB="128"

# Reports the ring size logd is running with right now, in KiB, following
# log.init's own derivation: log_buffer_size when set and non-zero, otherwise
# log_size, otherwise log.init's built-in 64. A non-numeric UCI value counts
# as unset, the same way uci_load_validate's uinteger rule treats it.
osi_effective_log_ring_kib() {
    local buffer
    local size

    buffer="$(uci -q get system.@system[0].log_buffer_size 2>/dev/null || echo "")"
    size="$(uci -q get system.@system[0].log_size 2>/dev/null || echo "")"
    case "$buffer" in ''|*[!0-9]*) buffer=0 ;; esac
    case "$size" in ''|*[!0-9]*) size=0 ;; esac

    if [ "$buffer" -gt 0 ]; then
        printf '%s' "$buffer"
    elif [ "$size" -gt 0 ]; then
        printf '%s' "$size"
    else
        printf '%s' "$OSI_LOGD_MIN_BUFFER_KIB"
    fi
}

# Idempotent, and fail-soft by construction: logging configuration must never
# be the reason irrigation does not start, so every step returns 0 on failure
# and the caller ignores the result.
ensure_persistent_syslog_sink() {
    local existing
    local ring

    command -v uci >/dev/null 2>&1 || return 0

    existing="$(uci -q get system.@system[0].log_file 2>/dev/null || echo "")"
    if [ -n "$existing" ]; then
        # An operator (or a previous run of this function) already chose a
        # sink. Never overwrite that choice -- it is also the only override
        # path, so this file needs no config knob of its own.
        logger -t node-red.init "persistent syslog sink already set (log_file=$existing)"
        return 0
    fi

    # Pin logd's in-RAM ring at the value it already has, before touching
    # log_size. log.init derives log_buffer_size from log_size when the former
    # is 0, so setting log_size alone would take a stock gateway's ring from
    # 128 KiB to 2 MiB and restart logd -- dropping the very lines this change
    # exists to keep. The pin is read back from the live config rather than
    # hardcoded, so it matches whatever this gateway is actually running.
    ring="$(osi_effective_log_ring_kib)"
    case "$ring" in ''|*[!0-9]*) ring="$OSI_LOGD_MIN_BUFFER_KIB" ;; esac
    if [ "$ring" -lt "$OSI_LOGD_MIN_BUFFER_KIB" ]; then
        # Below the OpenWrt default: raise to the floor rather than pin a
        # smaller ring. This is the one case that does restart logd, once.
        ring="$OSI_LOGD_MIN_BUFFER_KIB"
    fi
    uci -q set system.@system[0].log_buffer_size="$ring" || return 0
    uci -q set system.@system[0].log_file="$OSI_PERSISTENT_LOG_FILE" || return 0
    uci -q set system.@system[0].log_size="$OSI_PERSISTENT_LOG_SIZE_KIB" || return 0
    uci -q commit system || return 0

    mkdir -p "${OSI_PERSISTENT_LOG_FILE%/*}" 2>/dev/null || true

    # `reload`, not `restart`: log.init defines no reload_service, so rc.common
    # re-runs its start_service and procd starts only the instance whose
    # definition changed -- the new logfile writer. logd keeps running and the
    # ring survives. On every later boot the log service reads this UCI section
    # at START=12 and the sink is up long before Node-RED at START=99.
    if [ -x /etc/init.d/log ]; then
        /etc/init.d/log reload >/dev/null 2>&1 || true
    fi
    logger -t node-red.init "persistent syslog sink enabled (log_file=$OSI_PERSISTENT_LOG_FILE log_size=${OSI_PERSISTENT_LOG_SIZE_KIB}KiB, max 2 files, logd ring pinned at ${ring}KiB)"
}

load_chirpstack_env_value() {
    local key="$1"
    [ -f "$CHIRPSTACK_ENV_FILE" ] || return 0
    # Keep this parser aligned with prepare-pi-communication-config.sh and diagnose-pi-communication.sh.
    awk -v wanted="$key" '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            line=$0
            sub(/^[[:space:]]*/, "", line)
            split(line, parts, "=")
            env_key=parts[1]
            sub(/[[:space:]]*$/, "", env_key)
            if (env_key == wanted) {
                sub(/^[^=]*=/, "", line)
                gsub(/^[[:space:]]*/, "", line)
                gsub(/[[:space:]]*$/, "", line)
                gsub(/^["'\'']|["'\'']$/, "", line)
                print line
                exit
            }
        }
    ' "$CHIRPSTACK_ENV_FILE"
}

resolve_chirpstack_value() {
    local uci_key="$1"
    local env_key="$2"
    local value
    value="$(uci -q get "$uci_key" 2>/dev/null || echo "")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        logger -t node-red.init "chirpstack config $env_key source=uci"
        return 0
    fi
    value="$(load_chirpstack_env_value "$env_key" 2>/dev/null || echo "")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        logger -t node-red.init "chirpstack config $env_key source=env-fallback"
        return 0
    fi
    logger -t node-red.init "chirpstack config $env_key source=missing"
    return 0
}

# The cloud MQTT broker is configuration, not code. The "OSI Cloud Broker"
# node in flows.json carries "${OSI_CLOUD_BROKER_URL}", which Node-RED
# replaces at start with the value start_service() exports below. Changing it
# takes a Node-RED restart (deploy.sh and the account-link flow both restart).
#
# Precedence, first usable value wins:
#   1. osi-server.cloud.mqtt_broker_url  (the cloud's own answer at account link)
#   2. wss://<osi-server.cloud.server_host>/mqtt  (the host HTTPS sync was linked to)
#   3. OSI_DEFAULT_CLOUD_BROKER_URL  (the URL flows.json carried as a literal before)
# An unlinked gateway, or one linked to the default host, gets byte-identical
# behaviour to the old literal.
OSI_DEFAULT_CLOUD_BROKER_URL="wss://server.opensmartirrigation.org/mqtt"

# Describes why a configured value was rejected without printing it: the
# value may be mistyped credentials or a private host name.
cloud_broker_value_shape() {
    case "$1" in
        *://*) printf 'has a URL scheme' ;;
        *[[:space:]]*) printf 'contains whitespace' ;;
        *@*) printf 'contains userinfo' ;;
        */*|*\?*|*#*) printf 'contains a path, query or fragment' ;;
        *) printf 'contains characters outside host[:port]' ;;
    esac
}

# The broker URL for log lines: userinfo (user:password@) is masked.
cloud_broker_url_for_log() {
    local url="$1"
    local scheme
    local rest
    local authority
    case "$url" in
        *://*) ;;
        *) printf '%s' "$url"; return 0 ;;
    esac
    scheme="${url%%://*}"
    rest="${url#*://}"
    authority="${rest%%/*}"
    case "$authority" in
        *@*) printf '%s://***@%s%s' "$scheme" "${authority##*@}" "${rest#"$authority"}" ;;
        *) printf '%s' "$url" ;;
    esac
}

# Sets CLOUD_BROKER_URL and CLOUD_BROKER_URL_SOURCE (mqtt_broker_url,
# server_host or default). Pure apart from logging; no subshell, so the
# caller sees both variables.
resolve_cloud_broker_url() {
    local configured_url="$1"
    local server_host="$2"

    if [ -n "$configured_url" ]; then
        case "$configured_url" in
            *[[:space:]]*) ;;
            wss://?*|ws://?*|mqtts://?*|mqtt://?*)
                CLOUD_BROKER_URL="$configured_url"
                CLOUD_BROKER_URL_SOURCE="mqtt_broker_url"
                return 0
                ;;
        esac
        case "$configured_url" in
            *[[:space:]]*) logger -t node-red.init "WARN: ignoring osi-server.cloud.mqtt_broker_url (contains whitespace)" ;;
            *) logger -t node-red.init "WARN: ignoring osi-server.cloud.mqtt_broker_url (not a ws/wss/mqtt/mqtts URL)" ;;
        esac
    fi

    if [ -n "$server_host" ]; then
        # A bare host or host:port, as the account-link flow stores it.
        case "$server_host" in
            *[!]A-Za-z0-9.:[-]*|[!A-Za-z0-9[]*) ;;
            *)
                CLOUD_BROKER_URL="wss://$server_host/mqtt"
                CLOUD_BROKER_URL_SOURCE="server_host"
                return 0
                ;;
        esac
        # Falls back to the default broker, like an unlinked gateway.
        logger -t node-red.init "WARN: ignoring osi-server.cloud.server_host ($(cloud_broker_value_shape "$server_host")); MQTT uses the default broker"
    fi

    CLOUD_BROKER_URL="$OSI_DEFAULT_CLOUD_BROKER_URL"
    CLOUD_BROKER_URL_SOURCE="default"
    return 0
}

# Exit codes are an internal reason-class signal for this file's own
# start_service()/journal_media_invalid_reason() below -- nothing outside
# node-red.init reads them and no test pins the numbering itself (only the
# code-to-token mapping, in scripts/test-journal-v2-init-startup.js), so
# this is not an external ABI and renumbering only requires updating
# journal_media_invalid_reason() and that test. 0 = ok; every nonzero value
# names *why* the configured journal media root was rejected, so the caller
# can log a specific, actionable reason instead of a generic "invalid"
# message.
#   2 = byte limits invalid (cache/reserve not a positive safe integer)
#   3 = root is not an absolute path
#   4 = root is not an exact canonical spelling (resolve/parent/name mismatch)
#   5 = root itself (its final path component, not an ancestor) is a symlink
#   6 = parent directory could not be resolved (canonicalization failure on
#       the parent -- see 10 first if the tool itself is missing)
#   7 = root could not be created (mkdir failure, e.g. read-only/full parent)
#   8 = root exists but is not a directory
#   9 = root itself could not be resolved (canonicalization failure on the
#       root -- see 10 first if the tool itself is missing)
#  10 = no canonicalization tool is available on PATH at all (`readlink -f`
#       is missing or non-functional) -- reported before 6/9 so an absent
#       binary is diagnosed as itself, not misread as a filesystem problem
#       with the configured path
validate_journal_media_settings() {
    local photo_cache_bytes="$1"
    local min_free_bytes="$2"
    local configured_root="$3"
    local normalized_root
    local canonical_root
    local configured_parent
    local configured_name
    local canonical_parent
    local generated_root

    node -e '
const values = process.argv.slice(1);
if (values.length !== 2 || values.some((value) => !/^[0-9]+$/.test(value) ||
    !Number.isSafeInteger(Number(value)) || Number(value) <= 0)) process.exit(1);
' "$photo_cache_bytes" "$min_free_bytes" >/dev/null 2>&1 || return 2

    # This platform's busybox ships `readlink -f` (READLINK + the
    # FEATURE_READLINK_FOLLOW canonicalization option) but not the separate
    # `realpath` applet -- confirmed both live (agrolink-test-01: `realpath`
    # missing, `readlink` present) and in every Pi profile's busybox config
    # (READLINK default y, REALPATH default unset). Probe for the tool this
    # function actually depends on before touching the filesystem, so a
    # platform that lacks it too gets a reason that names the missing tool
    # instead of a filesystem-symptom code that sends an operator chasing a
    # perfectly fine path.
    readlink -f / >/dev/null 2>&1 || return 10

    case "$configured_root" in
        /*) ;;
        *) return 3 ;;
    esac
    normalized_root="$(node -e "process.stdout.write(require('path').resolve(process.argv[1]))" "$configured_root" 2>/dev/null)" || return 4
    [ "$normalized_root" = "$configured_root" ] || return 4
    [ ! -L "$configured_root" ] || return 5
    if [ ! -e "$configured_root" ]; then
        configured_parent="${configured_root%/*}"
        configured_name="${configured_root##*/}"
        [ -n "$configured_parent" ] || configured_parent="/"
        [ -n "$configured_name" ] || return 4
        canonical_parent="$(readlink -f "$configured_parent" 2>/dev/null)" || return 6
        [ "$canonical_parent" = "$configured_parent" ] || return 4
        if [ "$canonical_parent" = "/" ]; then
            generated_root="/$configured_name"
        else
            generated_root="$canonical_parent/$configured_name"
        fi
        [ "$generated_root" = "$configured_root" ] || return 4
        mkdir "$configured_root" || return 7
    fi
    [ -d "$configured_root" ] || return 8
    [ ! -L "$configured_root" ] || return 5
    canonical_root="$(readlink -f "$configured_root" 2>/dev/null)" || return 9
    [ "$canonical_root" = "$configured_root" ] || return 4
    printf '%s\n' "$canonical_root"
}

# Maps a validate_journal_media_settings() exit code to a short, stable
# reason-class token for the operator-facing log line. Never returns empty.
journal_media_invalid_reason() {
    case "$1" in
        2) echo "byte_limits_invalid" ;;
        3) echo "root_not_absolute" ;;
        4) echo "root_not_canonical" ;;
        5) echo "root_is_symlink" ;;
        6) echo "root_parent_unresolvable" ;;
        7) echo "root_uncreatable" ;;
        8) echo "root_not_a_directory" ;;
        9) echo "root_unresolvable" ;;
        10) echo "canonicalize_tool_missing" ;;
        *) echo "root_invalid" ;;
    esac
}

# payload switch repair begin
# deploy.sh routes flows.json, the GUI and the helper modules through
# /srv/node-red/payloads/active and keeps a copy of its payload swap helper
# beside them. A directory cannot be replaced by a link in one rename, so a
# power cut while a deploy converts the image GUI or a v0.8.1 module directory
# leaves that directory beside its absent path. Before Node-RED starts, the
# helper moves it back, so the start serves the complete payload without a
# deploy. It also records an active payload whose deploy was cut before its
# health check as unverified in /srv/node-red/payload-state.json: that payload
# still starts, because it is the code that matches the database, and the
# next deploy runs the check it owes first.
payload_switch_repair() {
    local helper="/srv/$PACKAGE_NAME/.payload-swap.js"
    local report
    [ -f "$helper" ] || return 0
    if report="$(node -e '
      const swap = require(process.argv[1]);
      const out = [swap.resumeInterruptedSwitch(process.argv[2], process.argv[3]), swap.recordBootState(process.argv[2])];
      process.stdout.write(out.filter(Boolean).join("\n"));
    ' "$helper" "/srv/$PACKAGE_NAME" "/usr/lib/node-red/gui" 2>&1)"; then
        [ -z "$report" ] || logger -t node-red.init "$report"
    else
        logger -t node-red.init "WARN: payload switch repair failed: $report"
    fi
}

# The active payload against the database, read-only, before Node-RED
# starts (swap helper bootSchemaDecision). A deploy cut after its migration
# and before its switch is completed forward to the payload that fits the
# database. One cut part way through the migration is held only where the
# old payload's start would make the retry fail (a new body of an object its
# boot node recreates is already stamped); otherwise the old payload starts,
# recorded "unverified", and the deploy run again completes the update. Any
# other mismatch is recorded "unverified" and Node-RED starts.
OSI_DB_PATH="${OSI_DB_PATH:-/data/db/farming.db}"
payload_schema_check() {
    local helper="/srv/$PACKAGE_NAME/.payload-swap.js"
    local schema stamped report
    [ -f "$helper" ] && [ -f "$OSI_DB_PATH" ] || return 0
    if ! command -v sqlite3 >/dev/null 2>&1; then
        logger -t node-red.init "WARN: sqlite3 is unavailable; the payload was not checked against the database"
        return 0
    fi
    if ! schema="$(sqlite3 -readonly -cmd '.timeout 5000' "$OSI_DB_PATH" "SELECT COALESCE((SELECT MAX(version) FROM schema_migrations WHERE status='applied'),0) || '|' || COALESCE((SELECT group_concat(version || ':' || checksum, ',') FROM (SELECT version, checksum FROM schema_migrations WHERE status='applied' ORDER BY version)), '')" 2>/dev/null)"; then
        logger -t node-red.init "WARN: could not read the database's schema ledger; the payload was not checked against it"
        return 0
    fi
    # The stamped fingerprints decide, for a migration cut part way, whether
    # the old payload may start (bootSchemaDecision, rule (g)).
    # A database from before the fingerprint table has nothing stamped; a
    # read that fails is no evidence, so it holds.
    if ! stamped="$(sqlite3 -readonly -cmd '.timeout 5000' "$OSI_DB_PATH" "SELECT name FROM sqlite_master WHERE type='table' AND name='schema_object_fingerprints'" 2>/dev/null)" || \
       { [ -n "$stamped" ] && ! stamped="$(sqlite3 -readonly -cmd '.timeout 5000' "$OSI_DB_PATH" "SELECT object_type || ' ' || object_name || ' ' || fingerprint FROM schema_object_fingerprints" 2>/dev/null)"; }; then
        logger -t node-red.init "HELD: Node-RED not started: the database's stamped schema fingerprints could not be read, so nothing proves the active payload fits the database. Check $OSI_DB_PATH (sqlite3 -readonly $OSI_DB_PATH 'PRAGMA integrity_check'), then run the deploy again, the same way."
        return 1
    fi
    if report="$(node -e '
      try {
        const swap = require(process.argv[1]);
        const line = swap.bootSchemaDecision(process.argv[2], process.argv[3], process.argv[4], process.argv[5], process.argv[6]);
        if (line) process.stdout.write(line);
      } catch (error) {
        process.stdout.write(String(error && error.message ? error.message : error));
        process.exit(1);
      }
    ' "$helper" "/srv/$PACKAGE_NAME" "/usr/lib/node-red/gui" "${schema%%|*}" "${schema#*|}" "$stamped" 2>&1)"; then
        [ -z "$report" ] || logger -t node-red.init "$report"
    else
        # The decision did not complete (for example /srv/node-red is not
        # writable): nothing proves the active payload fits the database, so
        # Node-RED is not started. The state file may be unwritable, so the
        # caller holds on this return.
        logger -t node-red.init "HELD: Node-RED not started: the payload schema check failed, so nothing proves the active payload fits the database: $report. Run the deploy again, the same way."
        return 1
    fi
}

# A gateway deploy.sh held stopped (payload-state.json says "held"): Node-RED
# does not start, after a reboot or a manual start either. It would run code
# whose health check failed, or older code on a migrated or half-updated
# database. The hold ends with a deploy that switches in a payload, or with
# the last-resort command in /srv/node-red/DEPLOY-HELD.
payload_hold_check() {
    local state="/srv/$PACKAGE_NAME/payload-state.json"
    grep -q '"state":"held"' "$state" 2>/dev/null || return 0
    local note
    note="$(cat "/srv/$PACKAGE_NAME/DEPLOY-HELD" 2>/dev/null || true)"
    logger -t node-red.init "HELD: Node-RED not started. ${note:-See $state; run the deploy again, the same way.}"
    return 1
}
# payload switch repair end

start_service() {
    mkdir -p /srv/$PACKAGE_NAME
    if [ -e "$OSI_DB_PATH.osi-recovery" ] || [ -L "$OSI_DB_PATH.osi-recovery" ]; then
        logger -t node-red.init "HELD: Database recovery is incomplete. Resolve $OSI_DB_PATH.osi-recovery before starting Node-RED."
        return 1
    fi
    payload_switch_repair
    payload_schema_check || return 0
    payload_hold_check || return 0

    ensure_persistent_syslog_sink

    # OSI Server cloud integration env vars. UCI is canonical; .chirpstack.env is
    # a per-key compatibility fallback for older field installations.
    if ! gateway_identity_heal; then
        logger -t node-red.init "gateway identity heal failed; resolving best available identity"
        gateway_identity_resolve || true
    fi
    local device_eui="${GATEWAY_IDENTITY_DEVICE_EUI:-$(uci -q get osi-server.cloud.device_eui 2>/dev/null || echo "")}"
    local device_eui_source="${GATEWAY_IDENTITY_DEVICE_EUI_SOURCE:-$(uci -q get osi-server.cloud.device_eui_source 2>/dev/null || echo "persisted")}"
    local device_eui_confidence="${GATEWAY_IDENTITY_DEVICE_EUI_CONFIDENCE:-$(uci -q get osi-server.cloud.device_eui_confidence 2>/dev/null || echo "provisional")}"
    local device_eui_last_verified_at="${GATEWAY_IDENTITY_DEVICE_EUI_LAST_VERIFIED_AT:-$(uci -q get osi-server.cloud.device_eui_last_verified_at 2>/dev/null || echo "")}"
    local link_gateway_device_eui=$(uci -q get osi-server.cloud.link_gateway_device_eui 2>/dev/null || echo "")
    device_eui="$(normalize_runtime_eui "$device_eui")"
    link_gateway_device_eui="$(normalize_runtime_eui "$link_gateway_device_eui")"
    local device_type=$(uci -q get osi-server.cloud.device_type 2>/dev/null || echo "GATEWAY")
    local mqtt_password=$(uci -q get osi-server.cloud.mqtt_password 2>/dev/null || echo "")
    local mqtt_broker_url=$(uci -q get osi-server.cloud.mqtt_broker_url 2>/dev/null || echo "")
    local server_host=$(uci -q get osi-server.cloud.server_host 2>/dev/null || echo "")
    resolve_cloud_broker_url "$mqtt_broker_url" "$server_host"
    logger -t node-red.init "cloud MQTT broker $(cloud_broker_url_for_log "$CLOUD_BROKER_URL") source=$CLOUD_BROKER_URL_SOURCE"
    # Only a URL that came from UCI may replace a literal in an older
    # flows.json; with nothing usable configured that literal stays.
    local cloud_broker_patch_url=""
    [ "$CLOUD_BROKER_URL_SOURCE" = "default" ] || cloud_broker_patch_url="$CLOUD_BROKER_URL"
    local allow_private_server_urls=$(uci -q get osi-server.cloud.allow_private_target 2>/dev/null || echo "0")
    local journal_photo_cache_bytes=$(uci -q get osi-server.cloud.journal_photo_cache_bytes 2>/dev/null || echo "4294967296")
    local journal_min_free_bytes=$(uci -q get osi-server.cloud.journal_min_free_bytes 2>/dev/null || echo "4294967296")
    local journal_media_root=$(uci -q get osi-server.cloud.journal_media_root 2>/dev/null || echo "/data/journal-media")
    local journal_media_root_canonical
    local journal_media_status
    local journal_replication_disable="0"
    journal_media_root_canonical="$(validate_journal_media_settings "$journal_photo_cache_bytes" "$journal_min_free_bytes" "$journal_media_root")"
    journal_media_status=$?
    if [ "$journal_media_status" -eq 0 ]; then
        journal_media_root="$journal_media_root_canonical"
    else
        # The journal feature fails closed (disabled), but Node-RED itself
        # must stay up: irrigation, telemetry and the GUI must not go down
        # because of a dormant, opt-in journal feature. Do not `return 1`
        # here. Do not export the unvalidated/bogus configured root either --
        # a downstream consumer must never see a value that failed
        # validation, even with the worker disabled as a second guard.
        logger -t node-red.init "journal media root '$journal_media_root' failed validation (reason=$(journal_media_invalid_reason "$journal_media_status")); disabling journal replication worker, Node-RED will still start"
        journal_replication_disable="1"
        journal_media_root=""
    fi
    local scoped_access_enabled=$(uci -q get osi-server.cloud.scoped_access_enabled 2>/dev/null || echo "0")
    local fw_version=$(uci -q get osi-server.cloud.firmware_version 2>/dev/null || echo "0.8.3")
    local openagri_weather_url=$(uci -q get osi-server.cloud.openagri_weather_url 2>/dev/null || echo "")
    local openagri_weather_username=$(uci -q get osi-server.cloud.openagri_weather_username 2>/dev/null || echo "")
    local openagri_weather_password=$(uci -q get osi-server.cloud.openagri_weather_password 2>/dev/null || echo "")
    local openagri_weather_bearer_token=$(uci -q get osi-server.cloud.openagri_weather_bearer_token 2>/dev/null || echo "")
    local openagri_weather_radius_km=$(uci -q get osi-server.cloud.openagri_weather_radius_km 2>/dev/null || echo "10")
    local openagri_weather_current_cache_minutes=$(uci -q get osi-server.cloud.openagri_weather_current_cache_minutes 2>/dev/null || echo "30")
    local openagri_weather_forecast_cache_minutes=$(uci -q get osi-server.cloud.openagri_weather_forecast_cache_minutes 2>/dev/null || echo "120")
    local weather_provider_default=$(uci -q get osi-server.cloud.weather_provider_default 2>/dev/null || echo "open_meteo")
    case "$weather_provider_default" in open_meteo|meteoswiss) ;; *) weather_provider_default="open_meteo" ;; esac

    # ChirpStack application and device profile IDs (per-installation)
    local cs_app_sensors=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_sensors CHIRPSTACK_APP_SENSORS)
    local cs_app_actuators=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_actuators CHIRPSTACK_APP_ACTUATORS)
    local cs_app_field_tester=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_field_tester CHIRPSTACK_APP_FIELD_TESTER)
    local cs_profile_kiwi=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_kiwi CHIRPSTACK_PROFILE_KIWI)
    local cs_profile_sdi12=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_sdi12 CHIRPSTACK_PROFILE_SDI12)
    local cs_profile_strega=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_strega CHIRPSTACK_PROFILE_STREGA)
    local cs_profile_lsn50=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_lsn50 CHIRPSTACK_PROFILE_LSN50)
    local cs_profile_clover=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_clover CHIRPSTACK_PROFILE_CLOVER)
    local cs_profile_rak10701=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_rak10701 CHIRPSTACK_PROFILE_RAK10701)
    local cs_profile_s2120=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_s2120 CHIRPSTACK_PROFILE_S2120)
    local osi_radio_capture=$(resolve_chirpstack_value osi-server.cloud.radio_capture_enabled OSI_RADIO_CAPTURE_ENABLED)
    local agroscope_forward_enabled=$(resolve_chirpstack_value osi-server.cloud.agroscope_forward_enabled AGROSCOPE_FORWARD_ENABLED)
    local agroscope_mqtt_host=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_host AGROSCOPE_MQTT_HOST)
    local agroscope_mqtt_port=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_port AGROSCOPE_MQTT_PORT)
    local agroscope_mqtt_username=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_username AGROSCOPE_MQTT_USERNAME)
    local agroscope_mqtt_password=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_password AGROSCOPE_MQTT_PASSWORD)
    [ -n "$agroscope_forward_enabled" ] || agroscope_forward_enabled="0"
    [ -n "$agroscope_mqtt_host" ] || agroscope_mqtt_host="51.107.5.147"
    [ -n "$agroscope_mqtt_port" ] || agroscope_mqtt_port="1883"
    local agroscope_forward_normalized
    local agroscope_runtime_mqtt_host="127.0.0.1"
    local agroscope_runtime_mqtt_port="1883"
    agroscope_forward_normalized="$(printf '%s' "$agroscope_forward_enabled" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
    case "$agroscope_forward_normalized" in
        1|true|yes|on)
            agroscope_runtime_mqtt_host="$agroscope_mqtt_host"
            agroscope_runtime_mqtt_port="$agroscope_mqtt_port"
            ;;
    esac

    # Auto-provision flows_cred.json with MQTT broker credentials.
    # Node-RED does not expand env vars in credential fields or MQTT client IDs,
    # so we write credential entries and concrete broker runtime values here.
    local cred_file="/srv/$PACKAGE_NAME/flows_cred.json"
    local flow_file="/srv/$PACKAGE_NAME/flows.json"
    local cloud_broker_node_id="ec43625ea99685a6"
    local agroscope_broker_node_id="agroscope-mqtt-broker"
    local startup_report startup_warning committed
    if startup_report="$(
        FLOW_FILE="$flow_file" \
        CRED_FILE="$cred_file" \
        CLOUD_BROKER_NODE_ID="$cloud_broker_node_id" \
        DEVICE_EUI_VALUE="$device_eui" \
        DEVICE_MQTT_PASSWORD_VALUE="$mqtt_password" \
        CLOUD_MQTT_BROKER_URL_VALUE="$cloud_broker_patch_url" \
        AGROSCOPE_BROKER_NODE_ID="$agroscope_broker_node_id" \
        AGROSCOPE_MQTT_HOST_VALUE="$agroscope_runtime_mqtt_host" \
        AGROSCOPE_MQTT_PORT_VALUE="$agroscope_runtime_mqtt_port" \
        AGROSCOPE_MQTT_USERNAME_VALUE="$agroscope_mqtt_username" \
        AGROSCOPE_MQTT_PASSWORD_VALUE="$agroscope_mqtt_password" \
        node 2>&1 <<'NODE'
const fs = require('fs');
const path = require('path');
const { createHash, randomUUID } = require('crypto');
const flowFile = process.env.FLOW_FILE;
const credFile = process.env.CRED_FILE;
const cloudBrokerNodeId = process.env.CLOUD_BROKER_NODE_ID;
const deviceEui = process.env.DEVICE_EUI_VALUE;
const deviceMqttPassword = process.env.DEVICE_MQTT_PASSWORD_VALUE;
const cloudMqttBrokerUrl = process.env.CLOUD_MQTT_BROKER_URL_VALUE || '';
const agroscopeBrokerNodeId = process.env.AGROSCOPE_BROKER_NODE_ID;
const agroscopeHost = process.env.AGROSCOPE_MQTT_HOST_VALUE || '127.0.0.1';
const agroscopePort = process.env.AGROSCOPE_MQTT_PORT_VALUE || '1883';
const agroscopeUsername = process.env.AGROSCOPE_MQTT_USERNAME_VALUE || '';
const agroscopePassword = process.env.AGROSCOPE_MQTT_PASSWORD_VALUE || '';

// Resolve the parent and any final symlinks, including when the final file
// is missing under an existing payloads/<stamp>/ directory.
function realTarget(file) {
  for (let hops = 0; hops < 40; hops++) {
    const dir = fs.realpathSync(path.dirname(file));
    file = path.join(dir, path.basename(file));
    let link;
    try {
      link = fs.readlinkSync(file);
    } catch (error) {
      if (error.code === 'EINVAL' || error.code === 'ENOENT') return file;
      throw error;
    }
    file = path.resolve(dir, link);
  }
  throw new Error('too many symlinks resolving ' + file);
}

function readJson(file, isValid) {
  let stat;
  try {
    stat = fs.statSync(file);
  } catch (error) {
    if (error.code === 'ENOENT') return { problem: 'missing' };
    throw error;
  }
  if (!stat.isFile()) throw new Error('expected a regular file at ' + file);
  return { stat, ...parseJson(fs.readFileSync(file), isValid) };
}

function parseJson(bytes, isValid) {
  if (!bytes.length) return { problem: 'empty' };
  if (bytes.every(byte => byte === 0)) return { problem: 'zeroed' };
  let value;
  try {
    value = JSON.parse(bytes.toString('utf8'));
  } catch (error) {
    if (!(error instanceof SyntaxError)) throw error;
    // JSON parser errors can contain fragments of credential values.
    return { problem: 'invalid JSON' };
  }
  if (!isValid(value)) return { problem: 'unexpected JSON shape' };
  return { bytes, value };
}

function syncDirectory(file) {
  const fd = fs.openSync(path.dirname(file), 'r');
  try {
    fs.fsyncSync(fd);
  } finally {
    fs.closeSync(fd);
  }
}

function quarantineName(file) {
  return file + '.corrupt-' + new Date().toISOString().replace(/:/g, '-') + '-' + randomUUID();
}

function syncPublishedFile(file, rollback) {
  try {
    syncDirectory(file);
  } catch (error) {
    try {
      rollback();
      syncDirectory(file);
    } catch (rollbackError) {
      throw new Error(error.message + '. Rollback could not be synced: ' + rollbackError.message);
    }
    throw error;
  }
}

function quarantine(file) {
  const saved = quarantineName(file);
  fs.renameSync(file, saved);
  syncPublishedFile(file, () => fs.renameSync(saved, file));
  return saved;
}

function clearRollbackLinks(file, verify = () => {}) {
  const parent = path.dirname(file);
  const prefix = path.basename(file) + '.tmp-';
  const leftovers = fs.readdirSync(parent).filter(name =>
    name.startsWith(prefix) && /^[a-f0-9-]{36}\.previous$/.test(name.slice(prefix.length)));
  if (!leftovers.length || !fs.existsSync(file)) return;
  verify();
  const dir = fs.openSync(parent, 'r');
  try {
    for (const name of leftovers) {
      const old = path.join(parent, name);
      const live = fs.statSync(file);
      const saved = fs.lstatSync(old);
      // The live file must already be valid. Even then, only remove an
      // owned rollback link to a regular file beside it.
      if (live.isFile() && saved.isFile()) fs.unlinkSync(old);
    }
    fs.fsyncSync(dir);
  } finally {
    fs.closeSync(dir);
  }
}

function writeAtomic(file, content, { mode, uid, gid }, previous, archive) {
  const temp = file + '.tmp-' + randomUUID();
  const dir = fs.openSync(path.dirname(file), 'r');
  let staged = false;
  try {
    const fd = fs.openSync(temp, 'wx', 0o600);
    staged = true;
    try {
      fs.fchownSync(fd, uid, gid);
      fs.fchmodSync(fd, mode & 0o7777);
      fs.writeFileSync(fd, content);
      fs.fsyncSync(fd);
    } finally {
      fs.closeSync(fd);
    }

    const saved = previous && (archive ? quarantineName(file) : temp + '.previous');
    if (saved) fs.linkSync(file, saved);
    try {
      fs.renameSync(temp, file);
      staged = false;
    } catch (error) {
      if (saved) {
        fs.unlinkSync(saved);
        fs.fsyncSync(dir);
      }
      throw error;
    }
    try {
      fs.fsyncSync(dir);
    } catch (error) {
      try {
        if (saved) fs.renameSync(saved, file);
        else fs.unlinkSync(file);
        fs.fsyncSync(dir);
      } catch (rollback) {
        throw new Error(error.message + '. Rollback could not be synced: ' + rollback.message);
      }
      throw error;
    }
    if (saved && !archive) {
      try {
        fs.unlinkSync(saved);
        fs.fsyncSync(dir);
      } catch (error) {
        console.warn('WARN: could not finish rollback-link cleanup for ' + file + ': ' + error.message);
      }
    }
    return archive ? saved : null;
  } finally {
    try {
      if (staged) fs.rmSync(temp, { force: true });
    } finally {
      fs.closeSync(dir);
    }
  }
}

function isFlows(value) {
  if (!Array.isArray(value) || value.some(node => !node || typeof node.id !== 'string' || typeof node.type !== 'string')) return false;
  const tabs = new Set(value.filter(node => node.type === 'tab').map(node => node.id));
  return value.some(node => node.type === 'http in' && tabs.has(node.z) &&
    typeof node.url === 'string' && node.url.startsWith('/') && typeof node.method === 'string' && node.method);
}

const root = path.dirname(flowFile);
const payloads = path.join(root, 'payloads');
const active = ['active', '.active'].map(name => path.join(payloads, name))
  .find(file => fs.lstatSync(file, { throwIfNoEntry: false }));
const flowLink = fs.lstatSync(flowFile, { throwIfNoEntry: false })?.isSymbolicLink();
const guiLink = fs.lstatSync('/usr/lib/node-red/gui', { throwIfNoEntry: false })?.isSymbolicLink();

function persistFlowHold(stamp, reason) {
  const line = 'HELD: Node-RED stopped. ' + reason + '. Re-run the deploy for this release to stage verified flows.';
  const mode = { mode: 0o644, uid: process.getuid(), gid: process.getgid() };
  const state = path.join(root, 'payload-state.json');
  const note = path.join(root, 'DEPLOY-HELD');
  const record = { format: 1, active: stamp, state: 'held', reason: line, updated_at: new Date().toISOString(), writer: 'flow-recovery' };
  console.error(line);
  writeAtomic(state, JSON.stringify(record) + '\n', mode, fs.existsSync(state), false);
  writeAtomic(note, line + '\n', mode, fs.existsSync(note), false);
}

try {
  const restoreLink = !fs.lstatSync(flowFile, { throwIfNoEntry: false }) && Boolean(active);
  const flowVia = restoreLink ? path.join(active, 'flows.json') : flowFile;
  let flowTarget;
  let stamp = '';
  const deployed = Boolean(active || flowLink || guiLink);
  let source;
  let sourceName = '/usr/share/flows.json';
  let live;
  try {
    flowTarget = realTarget(flowVia);
    if (deployed) {
      const realPayloads = fs.realpathSync(payloads);
      const dir = path.dirname(flowTarget);
      if (path.dirname(dir) !== realPayloads || path.basename(flowTarget) !== 'flows.json' ||
          (active && fs.realpathSync(active) !== dir)) {
        throw new Error('flows do not belong to the selected payload');
      }
      stamp = path.basename(dir);
    }
    live = readJson(flowTarget, isFlows);
    source = live;
    if (live.problem) {
      if (deployed) {
        const helper = require(path.join(root, '.payload-swap.js'));
        const bytes = helper.readPristineFlows(root, stamp);
        sourceName = path.join(path.dirname(flowTarget), 'flows.pristine.json');
        source = { stat: fs.statSync(sourceName), ...parseJson(bytes, isFlows) };
      } else {
        source = readJson(sourceName, isFlows);
      }
      if (source.problem) throw new Error('cannot restore flows.json (' + source.problem + ')');
    }
  } catch (error) {
    if (deployed) {
      persistFlowHold(stamp, error.message);
      if (live?.stat && live.problem) {
        const archive = quarantineName(flowTarget);
        fs.linkSync(flowTarget, archive);
        syncDirectory(flowTarget);
        console.error('HELD: preserved rejected flow bytes at ' + archive);
      }
    }
    throw error;
  }
  if (!live.problem) clearRollbackLinks(flowTarget);
  const settings = realTarget(path.join(root, 'settings.js'));
  // A completed legacy settings patch can leave a rollback name if power
  // goes out before cleanup. A valid live file must exist before removing it.
  clearRollbackLinks(settings, () => {
    const source = fs.readFileSync(settings, 'utf8');
    if (!source.trim()) throw new Error('settings.js is empty');
    new (require('vm').Script)(require('module').wrap(source));
  });
  const credTarget = realTarget(credFile);

  const flows = source.value;
  const credentials = readJson(credTarget, value => value !== null && typeof value === 'object' && !Array.isArray(value));
  // The init service runs as root. Match that owner and restrict access
  // even when upgrading a credential file written with an older default mode.
  const credentialMode = { mode: 0o600, uid: process.getuid(), gid: process.getgid() };
  if (credentials.stat) {
    if (credentials.stat.uid !== credentialMode.uid || credentials.stat.gid !== credentialMode.gid) {
      fs.chownSync(credTarget, credentialMode.uid, credentialMode.gid);
    }
    if ((credentials.stat.mode & 0o7777) !== credentialMode.mode) {
      fs.chmodSync(credTarget, credentialMode.mode);
    }
  }
  if (!credentials.problem) clearRollbackLinks(credTarget);
  const creds = credentials.value || {};
  let credsChanged = false;
  let flowsChanged = false;

  if (deviceEui && deviceMqttPassword) {
    const nextCloudCreds = { user: deviceEui, password: deviceMqttPassword };
    if (JSON.stringify(creds[cloudBrokerNodeId] || {}) !== JSON.stringify(nextCloudCreds)) {
      creds[cloudBrokerNodeId] = nextCloudCreds;
      credsChanged = true;
    }
  }

  if (agroscopeUsername && agroscopePassword) {
    const nextAgroscopeCreds = { user: agroscopeUsername, password: agroscopePassword };
    if (JSON.stringify(creds[agroscopeBrokerNodeId] || {}) !== JSON.stringify(nextAgroscopeCreds)) {
      creds[agroscopeBrokerNodeId] = nextAgroscopeCreds;
      credsChanged = true;
    }
  }

  const cloudBroker = flows.find((node) => node && node.id === cloudBrokerNodeId);
  if (cloudBroker && deviceEui && cloudBroker.clientid !== `device_${deviceEui}`) {
    cloudBroker.clientid = `device_${deviceEui}`;
    flowsChanged = true;
  }
  // Current flows carry the env placeholder and Node-RED substitutes
  // OSI_CLOUD_BROKER_URL at start: leave it alone. An older flows.json with a
  // literal URL (a rollback payload) gets the URL resolve_cloud_broker_url()
  // derived from UCI, so it reaches the same broker. Empty (source=default)
  // changes nothing, as before.
  if (cloudBroker && cloudMqttBrokerUrl && cloudBroker.broker !== '${OSI_CLOUD_BROKER_URL}'
    && cloudBroker.broker !== cloudMqttBrokerUrl) {
    cloudBroker.broker = cloudMqttBrokerUrl;
    flowsChanged = true;
  }

  const agroscopeBroker = flows.find((node) => node && node.id === agroscopeBrokerNodeId);
  if (agroscopeBroker) {
    if (agroscopeBroker.broker !== agroscopeHost) {
      agroscopeBroker.broker = agroscopeHost;
      flowsChanged = true;
    }
    if (agroscopeBroker.port !== agroscopePort) {
      agroscopeBroker.port = agroscopePort;
      flowsChanged = true;
    }
  }

  const corruptCredentials = credentials.stat && credentials.problem;
  const savedCredentials = credsChanged
    ? writeAtomic(credTarget, JSON.stringify(creds), credentialMode, credentials.stat, corruptCredentials)
    : corruptCredentials && quarantine(credTarget);
  if (savedCredentials) {
    console.log('WARN: quarantined flows_cred.json (' + credentials.problem + ') at ' + savedCredentials);
  }
  if (live.problem || flowsChanged) {
    const bytes = flowsChanged ? JSON.stringify(flows, null, 2) + '\n' : source.bytes;
    // Restore inside the selected payload if deployed. The public and active
    // symlinks still point to the same payload after recovery.
    const saved = writeAtomic(flowTarget, bytes, live.stat || source.stat, live.stat, live.problem);
    if (saved) console.log('WARN: quarantined flows.json (' + live.problem + ') at ' + saved);
    if (live.problem) console.log('WARN: restored flows.json (' + live.problem + ') from ' + sourceName + ' to ' + flowTarget);
  }
  if (restoreLink) {
    fs.symlinkSync(flowVia, flowFile);
    syncPublishedFile(flowFile, () => fs.unlinkSync(flowFile));
    console.log('WARN: recreated the public flows.json symlink');
  }
  if (live.problem || flowsChanged) {
    const digest = createHash('sha256').update(fs.readFileSync(flowTarget)).digest('hex');
    console.log('INFO: committed flows.json digest=' + digest + ' stamp=' + (stamp || 'image'));
  }
} catch (error) {
  console.error('ERROR: unable to prepare Node-RED runtime files: ' + error.message);
  process.exitCode = 1;
}
NODE
    )"; then
        if [ -n "$startup_report" ]; then
            printf '%s\n' "$startup_report" | while IFS= read -r line; do
                logger -t node-red.init "$line"
            done
            startup_warning="$(printf '%s\n' "$startup_report" | sed -n '/^WARN: /p')"
            # Also mark the lasting write on the boot console, before procd
            # starts Node-RED. The line contains no identity or credentials.
            committed="$(printf '%s\n' "$startup_report" | sed -n 's/^INFO: \(committed flows.json digest=.*\)$/\1/p')"
            if [ -n "$committed" ] && [ -c /dev/console ]; then
                printf 'node-red.init: %s\n' "$committed" 2>/dev/null >/dev/console || true
            fi
        fi
    else
        printf '%s\n' "$startup_report" >&2
        logger -t node-red.init "Node-RED startup refused: $startup_report"
        return 1
    fi

    procd_open_instance
    procd_set_param command node /usr/lib/node/$PACKAGE_NAME/red.js --userDir /srv/$PACKAGE_NAME
    procd_set_param env \
        OSI_NODE_RED_STARTUP_WARNING="$startup_warning" \
        DEVICE_EUI="$device_eui" \
        DEVICE_EUI_SOURCE="$device_eui_source" \
        DEVICE_EUI_CONFIDENCE="$device_eui_confidence" \
        DEVICE_EUI_LAST_VERIFIED_AT="$device_eui_last_verified_at" \
        LINK_GATEWAY_DEVICE_EUI="$link_gateway_device_eui" \
        DEVICE_TYPE="$device_type" \
        DEVICE_MQTT_PASSWORD="$mqtt_password" \
        OSI_SERVER_HOST="$server_host" \
        OSI_CLOUD_BROKER_URL="$CLOUD_BROKER_URL" \
        ALLOW_PRIVATE_SERVER_URLS="$allow_private_server_urls" \
        JOURNAL_PHOTO_CACHE_BYTES="$journal_photo_cache_bytes" \
        JOURNAL_MIN_FREE_BYTES="$journal_min_free_bytes" \
        JOURNAL_MEDIA_ROOT="$journal_media_root" \
        JOURNAL_REPLICATION_DISABLE="$journal_replication_disable" \
        OSI_SCOPED_ACCESS="$scoped_access_enabled" \
        FIRMWARE_VERSION="$fw_version" \
        OPENAGRI_WEATHER_URL="$openagri_weather_url" \
        OPENAGRI_WEATHER_USERNAME="$openagri_weather_username" \
        OPENAGRI_WEATHER_PASSWORD="$openagri_weather_password" \
        OPENAGRI_WEATHER_BEARER_TOKEN="$openagri_weather_bearer_token" \
        OPENAGRI_WEATHER_RADIUS_KM="$openagri_weather_radius_km" \
        OPENAGRI_WEATHER_CURRENT_CACHE_MINUTES="$openagri_weather_current_cache_minutes" \
        OPENAGRI_WEATHER_FORECAST_CACHE_MINUTES="$openagri_weather_forecast_cache_minutes" \
        OSI_WEATHER_PROVIDER_DEFAULT="$weather_provider_default" \
        CHIRPSTACK_APP_SENSORS="$cs_app_sensors" \
        CHIRPSTACK_APP_ACTUATORS="$cs_app_actuators" \
        CHIRPSTACK_APP_FIELD_TESTER="$cs_app_field_tester" \
        CHIRPSTACK_PROFILE_KIWI="$cs_profile_kiwi" \
        CHIRPSTACK_PROFILE_SDI12="$cs_profile_sdi12" \
        CHIRPSTACK_PROFILE_STREGA="$cs_profile_strega" \
        CHIRPSTACK_PROFILE_LSN50="$cs_profile_lsn50" \
        CHIRPSTACK_PROFILE_CLOVER="$cs_profile_clover" \
        CHIRPSTACK_PROFILE_RAK10701="$cs_profile_rak10701" \
        CHIRPSTACK_PROFILE_S2120="$cs_profile_s2120" \
        OSI_RADIO_CAPTURE_ENABLED="$osi_radio_capture" \
        AGROSCOPE_FORWARD_ENABLED="$agroscope_forward_enabled" \
        AGROSCOPE_MQTT_HOST="$agroscope_runtime_mqtt_host" \
        AGROSCOPE_MQTT_PORT="$agroscope_runtime_mqtt_port"
    procd_set_param respawn 3600 5 -1
    # osi-os#223: route Node-RED's stdout/stderr into syslog so node.error and
    # node.warn survive the process. Without these, a boot-node failure leaves
    # no trace at all. ensure_persistent_syslog_sink() above is what makes the
    # line survive a reboot as well as a service restart.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
