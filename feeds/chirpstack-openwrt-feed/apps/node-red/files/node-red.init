#!/bin/sh /etc/rc.common

START=99
STOP=99

USE_PROCD=1
PACKAGE_NAME=node-red

[ -f /usr/libexec/osi-gateway-identity.sh ] && . /usr/libexec/osi-gateway-identity.sh

normalize_runtime_eui() {
    local normalized
    normalized="$(normalize_gateway_eui "$1" 2>/dev/null || true)"
    printf '%s' "$normalized"
}

CHIRPSTACK_ENV_FILE="/srv/node-red/.chirpstack.env"

load_chirpstack_env_value() {
    local key="$1"
    [ -f "$CHIRPSTACK_ENV_FILE" ] || return 0
    # Keep this parser aligned with prepare-pi-communication-config.sh and diagnose-pi-communication.sh.
    awk -v wanted="$key" '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            line=$0
            sub(/^[[:space:]]*/, "", line)
            split(line, parts, "=")
            env_key=parts[1]
            sub(/[[:space:]]*$/, "", env_key)
            if (env_key == wanted) {
                sub(/^[^=]*=/, "", line)
                gsub(/^[[:space:]]*/, "", line)
                gsub(/[[:space:]]*$/, "", line)
                gsub(/^["'\'']|["'\'']$/, "", line)
                print line
                exit
            }
        }
    ' "$CHIRPSTACK_ENV_FILE"
}

resolve_chirpstack_value() {
    local uci_key="$1"
    local env_key="$2"
    local value
    value="$(uci -q get "$uci_key" 2>/dev/null || echo "")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        logger -t node-red.init "chirpstack config $env_key source=uci"
        return 0
    fi
    value="$(load_chirpstack_env_value "$env_key" 2>/dev/null || echo "")"
    if [ -n "$value" ]; then
        printf '%s' "$value"
        logger -t node-red.init "chirpstack config $env_key source=env-fallback"
        return 0
    fi
    logger -t node-red.init "chirpstack config $env_key source=missing"
    return 0
}

# Exit codes are an internal reason-class signal for this file's own
# start_service()/journal_media_invalid_reason() below -- nothing outside
# node-red.init reads them and no test pins the numbering itself (only the
# code-to-token mapping, in scripts/test-journal-v2-init-startup.js), so
# this is not an external ABI and renumbering only requires updating
# journal_media_invalid_reason() and that test. 0 = ok; every nonzero value
# names *why* the configured journal media root was rejected, so the caller
# can log a specific, actionable reason instead of a generic "invalid"
# message.
#   2 = byte limits invalid (cache/reserve not a positive safe integer)
#   3 = root is not an absolute path
#   4 = root is not an exact canonical spelling (resolve/parent/name mismatch)
#   5 = root itself (its final path component, not an ancestor) is a symlink
#   6 = parent directory could not be resolved (canonicalization failure on
#       the parent -- see 10 first if the tool itself is missing)
#   7 = root could not be created (mkdir failure, e.g. read-only/full parent)
#   8 = root exists but is not a directory
#   9 = root itself could not be resolved (canonicalization failure on the
#       root -- see 10 first if the tool itself is missing)
#  10 = no canonicalization tool is available on PATH at all (`readlink -f`
#       is missing or non-functional) -- reported before 6/9 so an absent
#       binary is diagnosed as itself, not misread as a filesystem problem
#       with the configured path
validate_journal_media_settings() {
    local photo_cache_bytes="$1"
    local min_free_bytes="$2"
    local configured_root="$3"
    local normalized_root
    local canonical_root
    local configured_parent
    local configured_name
    local canonical_parent
    local generated_root

    node -e '
const values = process.argv.slice(1);
if (values.length !== 2 || values.some((value) => !/^[0-9]+$/.test(value) ||
    !Number.isSafeInteger(Number(value)) || Number(value) <= 0)) process.exit(1);
' "$photo_cache_bytes" "$min_free_bytes" >/dev/null 2>&1 || return 2

    # This platform's busybox ships `readlink -f` (READLINK + the
    # FEATURE_READLINK_FOLLOW canonicalization option) but not the separate
    # `realpath` applet -- confirmed both live (agrolink-test-01: `realpath`
    # missing, `readlink` present) and in every Pi profile's busybox config
    # (READLINK default y, REALPATH default unset). Probe for the tool this
    # function actually depends on before touching the filesystem, so a
    # platform that lacks it too gets a reason that names the missing tool
    # instead of a filesystem-symptom code that sends an operator chasing a
    # perfectly fine path.
    readlink -f / >/dev/null 2>&1 || return 10

    case "$configured_root" in
        /*) ;;
        *) return 3 ;;
    esac
    normalized_root="$(node -e "process.stdout.write(require('path').resolve(process.argv[1]))" "$configured_root" 2>/dev/null)" || return 4
    [ "$normalized_root" = "$configured_root" ] || return 4
    [ ! -L "$configured_root" ] || return 5
    if [ ! -e "$configured_root" ]; then
        configured_parent="${configured_root%/*}"
        configured_name="${configured_root##*/}"
        [ -n "$configured_parent" ] || configured_parent="/"
        [ -n "$configured_name" ] || return 4
        canonical_parent="$(readlink -f "$configured_parent" 2>/dev/null)" || return 6
        [ "$canonical_parent" = "$configured_parent" ] || return 4
        if [ "$canonical_parent" = "/" ]; then
            generated_root="/$configured_name"
        else
            generated_root="$canonical_parent/$configured_name"
        fi
        [ "$generated_root" = "$configured_root" ] || return 4
        mkdir "$configured_root" || return 7
    fi
    [ -d "$configured_root" ] || return 8
    [ ! -L "$configured_root" ] || return 5
    canonical_root="$(readlink -f "$configured_root" 2>/dev/null)" || return 9
    [ "$canonical_root" = "$configured_root" ] || return 4
    printf '%s\n' "$canonical_root"
}

# Maps a validate_journal_media_settings() exit code to a short, stable
# reason-class token for the operator-facing log line. Never returns empty.
journal_media_invalid_reason() {
    case "$1" in
        2) echo "byte_limits_invalid" ;;
        3) echo "root_not_absolute" ;;
        4) echo "root_not_canonical" ;;
        5) echo "root_is_symlink" ;;
        6) echo "root_parent_unresolvable" ;;
        7) echo "root_uncreatable" ;;
        8) echo "root_not_a_directory" ;;
        9) echo "root_unresolvable" ;;
        10) echo "canonicalize_tool_missing" ;;
        *) echo "root_invalid" ;;
    esac
}

start_service() {
    mkdir -p /srv/$PACKAGE_NAME

    # OSI Server cloud integration env vars. UCI is canonical; .chirpstack.env is
    # a per-key compatibility fallback for older field installations.
    if ! gateway_identity_heal; then
        logger -t node-red.init "gateway identity heal failed; resolving best available identity"
        gateway_identity_resolve || true
    fi
    local device_eui="${GATEWAY_IDENTITY_DEVICE_EUI:-$(uci -q get osi-server.cloud.device_eui 2>/dev/null || echo "")}"
    local device_eui_source="${GATEWAY_IDENTITY_DEVICE_EUI_SOURCE:-$(uci -q get osi-server.cloud.device_eui_source 2>/dev/null || echo "persisted")}"
    local device_eui_confidence="${GATEWAY_IDENTITY_DEVICE_EUI_CONFIDENCE:-$(uci -q get osi-server.cloud.device_eui_confidence 2>/dev/null || echo "provisional")}"
    local device_eui_last_verified_at="${GATEWAY_IDENTITY_DEVICE_EUI_LAST_VERIFIED_AT:-$(uci -q get osi-server.cloud.device_eui_last_verified_at 2>/dev/null || echo "")}"
    local link_gateway_device_eui=$(uci -q get osi-server.cloud.link_gateway_device_eui 2>/dev/null || echo "")
    device_eui="$(normalize_runtime_eui "$device_eui")"
    link_gateway_device_eui="$(normalize_runtime_eui "$link_gateway_device_eui")"
    local device_type=$(uci -q get osi-server.cloud.device_type 2>/dev/null || echo "GATEWAY")
    local mqtt_password=$(uci -q get osi-server.cloud.mqtt_password 2>/dev/null || echo "")
    local server_host=$(uci -q get osi-server.cloud.server_host 2>/dev/null || echo "")
    local allow_private_server_urls=$(uci -q get osi-server.cloud.allow_private_target 2>/dev/null || echo "0")
    local scoped_access_enabled=$(uci -q get osi-server.cloud.scoped_access_enabled 2>/dev/null || echo "0")
    local journal_photo_cache_bytes=$(uci -q get osi-server.cloud.journal_photo_cache_bytes 2>/dev/null || echo "4294967296")
    local journal_min_free_bytes=$(uci -q get osi-server.cloud.journal_min_free_bytes 2>/dev/null || echo "4294967296")
    local journal_media_root=$(uci -q get osi-server.cloud.journal_media_root 2>/dev/null || echo "/data/journal-media")
    local journal_media_root_canonical
    local journal_media_status
    local journal_replication_disable="0"
    journal_media_root_canonical="$(validate_journal_media_settings "$journal_photo_cache_bytes" "$journal_min_free_bytes" "$journal_media_root")"
    journal_media_status=$?
    if [ "$journal_media_status" -eq 0 ]; then
        journal_media_root="$journal_media_root_canonical"
    else
        # The journal feature fails closed (disabled), but Node-RED itself
        # must stay up: irrigation, telemetry and the GUI must not go down
        # because of a dormant, opt-in journal feature. Do not `return 1`
        # here. Do not export the unvalidated/bogus configured root either --
        # a downstream consumer must never see a value that failed
        # validation, even with the worker disabled as a second guard.
        logger -t node-red.init "journal media root '$journal_media_root' failed validation (reason=$(journal_media_invalid_reason "$journal_media_status")); disabling journal replication worker, Node-RED will still start"
        journal_replication_disable="1"
        journal_media_root=""
    fi
    local fw_version=$(uci -q get osi-server.cloud.firmware_version 2>/dev/null || echo "0.7.0")
    local openagri_weather_url=$(uci -q get osi-server.cloud.openagri_weather_url 2>/dev/null || echo "")
    local openagri_weather_username=$(uci -q get osi-server.cloud.openagri_weather_username 2>/dev/null || echo "")
    local openagri_weather_password=$(uci -q get osi-server.cloud.openagri_weather_password 2>/dev/null || echo "")
    local openagri_weather_bearer_token=$(uci -q get osi-server.cloud.openagri_weather_bearer_token 2>/dev/null || echo "")
    local openagri_weather_radius_km=$(uci -q get osi-server.cloud.openagri_weather_radius_km 2>/dev/null || echo "10")
    local openagri_weather_current_cache_minutes=$(uci -q get osi-server.cloud.openagri_weather_current_cache_minutes 2>/dev/null || echo "30")
    local openagri_weather_forecast_cache_minutes=$(uci -q get osi-server.cloud.openagri_weather_forecast_cache_minutes 2>/dev/null || echo "120")
    local lsn50_writer_disable=$(uci -q get osi-server.cloud.lsn50_writer_disable 2>/dev/null || echo "0")

    # ChirpStack application and device profile IDs (per-installation)
    local cs_app_sensors=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_sensors CHIRPSTACK_APP_SENSORS)
    local cs_app_actuators=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_actuators CHIRPSTACK_APP_ACTUATORS)
    local cs_app_field_tester=$(resolve_chirpstack_value osi-server.cloud.chirpstack_app_field_tester CHIRPSTACK_APP_FIELD_TESTER)
    local cs_profile_kiwi=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_kiwi CHIRPSTACK_PROFILE_KIWI)
    local cs_profile_strega=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_strega CHIRPSTACK_PROFILE_STREGA)
    local cs_profile_lsn50=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_lsn50 CHIRPSTACK_PROFILE_LSN50)
    local cs_profile_clover=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_clover CHIRPSTACK_PROFILE_CLOVER)
    local cs_profile_rak10701=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_rak10701 CHIRPSTACK_PROFILE_RAK10701)
    local cs_profile_s2120=$(resolve_chirpstack_value osi-server.cloud.chirpstack_profile_s2120 CHIRPSTACK_PROFILE_S2120)
    local agroscope_forward_enabled=$(resolve_chirpstack_value osi-server.cloud.agroscope_forward_enabled AGROSCOPE_FORWARD_ENABLED)
    local agroscope_mqtt_host=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_host AGROSCOPE_MQTT_HOST)
    local agroscope_mqtt_port=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_port AGROSCOPE_MQTT_PORT)
    local agroscope_mqtt_username=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_username AGROSCOPE_MQTT_USERNAME)
    local agroscope_mqtt_password=$(resolve_chirpstack_value osi-server.cloud.agroscope_mqtt_password AGROSCOPE_MQTT_PASSWORD)
    [ -n "$agroscope_forward_enabled" ] || agroscope_forward_enabled="0"
    [ -n "$agroscope_mqtt_host" ] || agroscope_mqtt_host="51.107.5.147"
    [ -n "$agroscope_mqtt_port" ] || agroscope_mqtt_port="1883"
    local agroscope_forward_normalized
    local agroscope_runtime_mqtt_host="127.0.0.1"
    local agroscope_runtime_mqtt_port="1883"
    agroscope_forward_normalized="$(printf '%s' "$agroscope_forward_enabled" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
    case "$agroscope_forward_normalized" in
        1|true|yes|on)
            agroscope_runtime_mqtt_host="$agroscope_mqtt_host"
            agroscope_runtime_mqtt_port="$agroscope_mqtt_port"
            ;;
    esac

    # Auto-provision flows_cred.json with MQTT broker credentials.
    # Node-RED does not expand env vars in credential fields, MQTT client IDs,
    # or plain config-node properties like "broker" (mapEnvVarProperties only
    # substitutes a property whose entire value is a literal "${VAR}" and, on
    # a missing/empty var, leaves that literal string in place rather than
    # falling back) -- so we write credential entries and concrete broker
    # runtime values here, same as the Agroscope broker below.
    local cred_file="/srv/$PACKAGE_NAME/flows_cred.json"
    local flow_file="/srv/$PACKAGE_NAME/flows.json"
    local cloud_broker_node_id="ec43625ea99685a6"
    local agroscope_broker_node_id="agroscope-mqtt-broker"
    if [ -f "$flow_file" ]; then
        FLOW_FILE="$flow_file" \
        CRED_FILE="$cred_file" \
        CLOUD_BROKER_NODE_ID="$cloud_broker_node_id" \
        DEVICE_EUI_VALUE="$device_eui" \
        DEVICE_MQTT_PASSWORD_VALUE="$mqtt_password" \
        CLOUD_BROKER_HOST_VALUE="$server_host" \
        AGROSCOPE_BROKER_NODE_ID="$agroscope_broker_node_id" \
        AGROSCOPE_MQTT_HOST_VALUE="$agroscope_runtime_mqtt_host" \
        AGROSCOPE_MQTT_PORT_VALUE="$agroscope_runtime_mqtt_port" \
        AGROSCOPE_MQTT_USERNAME_VALUE="$agroscope_mqtt_username" \
        AGROSCOPE_MQTT_PASSWORD_VALUE="$agroscope_mqtt_password" \
        node <<'NODE'
const fs = require('fs');
const flowFile = process.env.FLOW_FILE;
const credFile = process.env.CRED_FILE;
const cloudBrokerNodeId = process.env.CLOUD_BROKER_NODE_ID;
const deviceEui = process.env.DEVICE_EUI_VALUE;
const deviceMqttPassword = process.env.DEVICE_MQTT_PASSWORD_VALUE;
// osi-server.cloud.server_host is populated at account-link time from the
// linked cloud's delivered MQTT broker URL host (preferred) or its server
// URL host (fallback) -- see the account-link finalize handler in flows.json.
// Only the host survives into UCI/env today (the link response's full
// mqttBrokerUrl scheme+path is not persisted), so we can only reconstruct a
// "wss://<host>/mqtt" URL, not honor an arbitrary scheme/path from the cloud.
// A gateway that has never linked, or is linked to the original cloud, keeps
// server_host empty or equal to the shipped default host, in which case we
// leave the broker field at its hardcoded flows.json default untouched.
const cloudBrokerHostRaw = String(process.env.CLOUD_BROKER_HOST_VALUE || '').trim();
const CLOUD_BROKER_HOST_RE = /^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(?::\d{1,5})?$/;
const cloudBrokerHost = CLOUD_BROKER_HOST_RE.test(cloudBrokerHostRaw) ? cloudBrokerHostRaw : '';
const agroscopeBrokerNodeId = process.env.AGROSCOPE_BROKER_NODE_ID;
const agroscopeHost = process.env.AGROSCOPE_MQTT_HOST_VALUE || '127.0.0.1';
const agroscopePort = process.env.AGROSCOPE_MQTT_PORT_VALUE || '1883';
const agroscopeUsername = process.env.AGROSCOPE_MQTT_USERNAME_VALUE || '';
const agroscopePassword = process.env.AGROSCOPE_MQTT_PASSWORD_VALUE || '';

function readJson(filePath, fallback) {
  try {
    if (fs.existsSync(filePath)) return JSON.parse(fs.readFileSync(filePath, 'utf8') || '{}');
  } catch (_) {}
  return fallback;
}

try {
  const flows = JSON.parse(fs.readFileSync(flowFile, 'utf8'));
  const creds = readJson(credFile, {});
  let credsChanged = false;
  let flowsChanged = false;

  if (deviceEui && deviceMqttPassword) {
    const nextCloudCreds = { user: deviceEui, password: deviceMqttPassword };
    if (JSON.stringify(creds[cloudBrokerNodeId] || {}) !== JSON.stringify(nextCloudCreds)) {
      creds[cloudBrokerNodeId] = nextCloudCreds;
      credsChanged = true;
    }
  }

  if (agroscopeUsername && agroscopePassword) {
    const nextAgroscopeCreds = { user: agroscopeUsername, password: agroscopePassword };
    if (JSON.stringify(creds[agroscopeBrokerNodeId] || {}) !== JSON.stringify(nextAgroscopeCreds)) {
      creds[agroscopeBrokerNodeId] = nextAgroscopeCreds;
      credsChanged = true;
    }
  }

  const cloudBroker = flows.find((node) => node && node.id === cloudBrokerNodeId);
  if (cloudBroker && deviceEui && cloudBroker.clientid !== `device_${deviceEui}`) {
    cloudBroker.clientid = `device_${deviceEui}`;
    flowsChanged = true;
  }

  // Fix B: point the cloud MQTT broker at the linked cloud's host instead of
  // the hardcoded default, when a linked host is known. cloudBrokerHost is
  // only set once account-link has persisted osi-server.cloud.server_host;
  // until then (or if it somehow holds an invalid value) this is a no-op and
  // the shipped default ("wss://server.opensmartirrigation.org/mqtt") stays,
  // which is also exactly what a gateway linked to that same default cloud
  // computes here, so the update is idempotent and behavior-preserving.
  if (cloudBroker && cloudBrokerHost) {
    const desiredBrokerUrl = `wss://${cloudBrokerHost}/mqtt`;
    if (cloudBroker.broker !== desiredBrokerUrl) {
      cloudBroker.broker = desiredBrokerUrl;
      flowsChanged = true;
    }
  }

  const agroscopeBroker = flows.find((node) => node && node.id === agroscopeBrokerNodeId);
  if (agroscopeBroker) {
    if (agroscopeBroker.broker !== agroscopeHost) {
      agroscopeBroker.broker = agroscopeHost;
      flowsChanged = true;
    }
    if (agroscopeBroker.port !== agroscopePort) {
      agroscopeBroker.port = agroscopePort;
      flowsChanged = true;
    }
  }

  if (credsChanged) fs.writeFileSync(credFile, JSON.stringify(creds));
  if (flowsChanged) fs.writeFileSync(flowFile, JSON.stringify(flows, null, 2) + '\n');
} catch (error) {
  console.error('[node-red.init] unable to update MQTT runtime config:', error.message);
}
NODE
    fi

    procd_open_instance
    procd_set_param command node /usr/lib/node/$PACKAGE_NAME/red.js --userDir /srv/$PACKAGE_NAME
    procd_set_param env \
        DEVICE_EUI="$device_eui" \
        DEVICE_EUI_SOURCE="$device_eui_source" \
        DEVICE_EUI_CONFIDENCE="$device_eui_confidence" \
        DEVICE_EUI_LAST_VERIFIED_AT="$device_eui_last_verified_at" \
        LINK_GATEWAY_DEVICE_EUI="$link_gateway_device_eui" \
        DEVICE_TYPE="$device_type" \
        DEVICE_MQTT_PASSWORD="$mqtt_password" \
        OSI_SERVER_HOST="$server_host" \
        ALLOW_PRIVATE_SERVER_URLS="$allow_private_server_urls" \
        OSI_SCOPED_ACCESS="$scoped_access_enabled" \
        JOURNAL_PHOTO_CACHE_BYTES="$journal_photo_cache_bytes" \
        JOURNAL_MIN_FREE_BYTES="$journal_min_free_bytes" \
        JOURNAL_MEDIA_ROOT="$journal_media_root" \
        JOURNAL_REPLICATION_DISABLE="$journal_replication_disable" \
        FIRMWARE_VERSION="$fw_version" \
        OPENAGRI_WEATHER_URL="$openagri_weather_url" \
        OPENAGRI_WEATHER_USERNAME="$openagri_weather_username" \
        OPENAGRI_WEATHER_PASSWORD="$openagri_weather_password" \
        OPENAGRI_WEATHER_BEARER_TOKEN="$openagri_weather_bearer_token" \
        OPENAGRI_WEATHER_RADIUS_KM="$openagri_weather_radius_km" \
        OPENAGRI_WEATHER_CURRENT_CACHE_MINUTES="$openagri_weather_current_cache_minutes" \
        OPENAGRI_WEATHER_FORECAST_CACHE_MINUTES="$openagri_weather_forecast_cache_minutes" \
        LSN50_WRITER_DISABLE="$lsn50_writer_disable" \
        CHIRPSTACK_APP_SENSORS="$cs_app_sensors" \
        CHIRPSTACK_APP_ACTUATORS="$cs_app_actuators" \
        CHIRPSTACK_APP_FIELD_TESTER="$cs_app_field_tester" \
        CHIRPSTACK_PROFILE_KIWI="$cs_profile_kiwi" \
        CHIRPSTACK_PROFILE_STREGA="$cs_profile_strega" \
        CHIRPSTACK_PROFILE_LSN50="$cs_profile_lsn50" \
        CHIRPSTACK_PROFILE_CLOVER="$cs_profile_clover" \
        CHIRPSTACK_PROFILE_RAK10701="$cs_profile_rak10701" \
        CHIRPSTACK_PROFILE_S2120="$cs_profile_s2120" \
        AGROSCOPE_FORWARD_ENABLED="$agroscope_forward_enabled" \
        AGROSCOPE_MQTT_HOST="$agroscope_runtime_mqtt_host" \
        AGROSCOPE_MQTT_PORT="$agroscope_runtime_mqtt_port"
    procd_set_param respawn 3600 5 -1
    procd_close_instance
}
