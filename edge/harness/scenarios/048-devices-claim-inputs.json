        "method": "POST",
        "path": "/auth/register",
        "body": {
          "username": "farmer",
          "password": "synthetic-pass-1"
        }
      }
    },
    {
      "id": "login",
      "http": {
        "method": "POST",
        "path": "/auth/login",
        "body": {
