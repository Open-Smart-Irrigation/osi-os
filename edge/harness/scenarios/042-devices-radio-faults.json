{
  "name": "devices-radio-faults",
  "steps": [
    {
      "id": "register",
      "http": {
        "method": "POST",
        "path": "/auth/register",
        "body": {
          "username": "farmer",
          "password": "synthetic-pass-1"
        }
      }
    },
    {
      "id": "login",
      "http": {
        "method": "POST",
        "path": "/auth/login",
        "body": {
          "username": "farmer",
          "password": "synthetic-pass-1"
        }
      },
      "capture": {
        "token": "json.token"
      }
    },
    {
      "id": "get-keys-denied",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000082",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      },
      "radioFault": [
        {
          "rpc": "getKeys",
          "eui": "A840410000000082",
          "code": 7,
          "details": "review GetKeys denied"
        }
      ]
    },
    {
      "id": "get-keys-retry",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000082",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "create-keys-unavailable",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000083",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      },
      "radioFault": [
        {
          "rpc": "createKeys",
          "eui": "A840410000000083",
          "code": 14,
          "details": "review CreateKeys unavailable"
        }
      ]
    },
    {
      "id": "create-keys-retry",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000083",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "update-keys-setup",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000084",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "update-keys-rejected",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000084",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFE"
        }
      },
      "radioFault": [
        {
          "rpc": "updateKeys",
          "eui": "A840410000000084",
          "code": 3,
          "details": "review UpdateKeys rejected"
        }
      ]
    },
    {
      "id": "slow-rename-setup",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000085",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "slow-rename",
      "http": {
        "method": "PUT",
        "path": "/api/devices/A840410000000085/name",
        "auth": "token",
        "body": {
          "name": "Review renamed"
        }
      },
      "radioFault": [
        {
          "rpc": "get",
          "eui": "A840410000000085",
          "delayMs": 3250
        },
        {
          "rpc": "update",
          "eui": "A840410000000085",
          "delayMs": 3250
        }
      ]
    },
    {
      "id": "rename-remote-setup",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000086",
          "name": "Review claim",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "force-after-provision-failure",
      "sql": "CREATE TRIGGER review_fail_rename BEFORE UPDATE ON devices WHEN NEW.deveui='A840410000000086' BEGIN SELECT RAISE(ABORT,'review local update failure'); END"
    },
    {
      "id": "rename-remote-only-before-db-failure",
      "http": {
        "method": "POST",
        "path": "/api/devices",
        "auth": "token",
        "body": {
          "deveui": "A840410000000086",
          "name": "Review remote label",
          "type_id": "KIWI_SENSOR",
          "appkey": "00112233445566778899AABBCCDDEEFF"
        }
      }
    },
    {
      "id": "drop-after-provision-failure",
      "sql": "DROP TRIGGER review_fail_rename"
    },
    {
      "id": "rename-already-matches-remote",
      "http": {
        "method": "PUT",
        "path": "/api/devices/A840410000000086/name",
        "auth": "token",
        "body": {
          "name": "Review remote label"
        }
      }
    },
    {
      "id": "retry-slow-rename",
      "http": {
        "method": "PUT",
        "path": "/api/devices/A840410000000085/name",
        "auth": "token",
        "body": {
          "name": "Review renamed again"
        }
      }
    },
    {
      "id": "rename-get-exhausts-budget",
      "radioFault": [
        {
          "rpc": "get",
          "eui": "A840410000000085",
          "delayMs": 6500
        }
      ],
      "http": {
        "method": "PUT",
        "path": "/api/devices/A840410000000085/name",
        "auth": "token",
        "body": {
          "name": "Review GET deadline"
        }
      }
    }
  ]
}
