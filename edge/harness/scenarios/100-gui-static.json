{
  "name": "gui-static",
  "description": "Static files, routing, caching and byte ranges at the GUI mount.",
  "steps": [
    {"id":"root","http":{"method":"GET","path":"/gui"}},
    {"id":"index","http":{"method":"GET","path":"/gui/"}},
    {"id":"head","http":{"method":"HEAD","path":"/gui/"}},
    {"id":"case","http":{"method":"GET","path":"/GUI/"}},
    {"id":"js","http":{"method":"GET","path":"/gui/app.js"}},
    {"id":"css","http":{"method":"GET","path":"/gui/app.css"}},
    {"id":"svg","http":{"method":"GET","path":"/gui/app.svg"}},
    {"id":"png","http":{"method":"GET","path":"/gui/app.png"}},
    {"id":"woff2","http":{"method":"GET","path":"/gui/app.woff2"}},
    {"id":"js.map","http":{"method":"GET","path":"/gui/app.js.map"}},
    {"id":"json","http":{"method":"GET","path":"/gui/app.json"}},
    {"id":"unknown-type","http":{"method":"GET","path":"/gui/unknown.ext-osi-fixture"}},
    {"id":"nested-redirect","http":{"method":"GET","path":"/gui/nested?q=a&b=c"}},
    {"id":"nested-index","http":{"method":"GET","path":"/gui/nested/"}},
    {"id":"missing","http":{"method":"GET","path":"/gui/missing?ignored=yes"}},
    {"id":"missing-head","http":{"method":"HEAD","path":"/gui/missing"}},
    {"id":"post","http":{"method":"POST","path":"/gui/"}},
    {"id":"dotfile","http":{"method":"GET","path":"/gui/.hidden"}},
    {"id":"traversal","http":{"method":"GET","path":"/gui/%2e%2e/outside.txt"}},
    {"id":"encoded-traversal","http":{"method":"GET","path":"/gui/%2e%2e%2foutside.txt"}},
    {"id":"encoded-slash","http":{"method":"GET","path":"/gui/nested%2findex.html"}},
    {"id":"encoded-trailing-slash","http":{"method":"GET","path":"/gui/nested%2f"}},
    {"id":"internal-traversal","http":{"method":"GET","path":"/gui/nested/%2e%2e/app.js"}},
    {"id":"nul","http":{"method":"GET","path":"/gui/%00"}},
    {"id":"range","http":{"method":"GET","path":"/gui/app.js","headers":{"Range":"bytes=0-3"}}},
    {"id":"suffix","http":{"method":"GET","path":"/gui/app.js","headers":{"Range":"bytes=-4"}}},
    {"id":"multiple","http":{"method":"GET","path":"/gui/app.js","headers":{"Range":"bytes=0-1,4-5"}}},
    {"id":"combined","http":{"method":"GET","path":"/gui/app.js","headers":{"Range":"bytes=0-1,2-4"}}},
    {"id":"range-head","http":{"method":"HEAD","path":"/gui/app.js","headers":{"Range":"bytes=0-3"}}},
    {"id":"etag","http":{"method":"GET","path":"/gui/","headers":{"If-None-Match":"W/\"27-18cc251f400\""}}},
    {"id":"modified","http":{"method":"GET","path":"/gui/","headers":{"If-Modified-Since":"Mon, 01 Jan 2024 00:00:00 GMT"}}},
    {"id":"no-cache","http":{"method":"GET","path":"/gui/","headers":{"If-None-Match":"*","Cache-Control":"no-cache"}}},
    {"id":"if-range-stale","http":{"method":"GET","path":"/gui/app.js","headers":{"Range":"bytes=0-3","If-Range":"Sun, 31 Dec 2023 00:00:00 GMT"}}}
  ]
}
