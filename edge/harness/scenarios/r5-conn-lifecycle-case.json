{
 "name": "r5-conn-lifecycle-case",
 "description": "Fix round connections (item 6): push.js lifecycleBindingTx sorts the live schedule snapshot with lifecycleScheduleSort (String.prototype.localeCompare, stable): of two schedule_uuid equal but for case, the lower-case one comes first. Go ordered by schedule_uuid COLLATE NOCASE only, which leaves such a pair in table order. The managed pause stores the binding in conditional_control_json.",
 "steps": [
  {
   "id": "register",
   "http": {
    "method": "POST",
    "path": "/auth/register",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   }
  },
  {
   "id": "login",
   "http": {
    "method": "POST",
    "path": "/auth/login",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   },
   "capture": {
    "token": "json.token"
   }
  },
  {
   "id": "create-No data",
   "http": {
    "method": "POST",
    "path": "/api/irrigation-zones",
    "auth": "token",
    "body": {
     "name": "No data",
     "timezone": "Europe/Zurich"
    }
   }
  },
  {
   "id": "schedule-1",
   "http": {
    "method": "PUT",
    "path": "/api/irrigation-zones/1/schedule",
    "auth": "token",
    "body": {
     "trigger_metric": "SWT_1",
     "threshold_kpa": 20,
     "duration_minutes": 20,
     "enabled": true
    }
   }
  },
  {
   "id": "seed-managed-policy",
   "why": "Review fixture data for the paired parity probe.",
   "sql": "INSERT INTO irrigation_policies(policy_uuid,zone_uuid,condition_json,timezone,enabled) SELECT 'synthetic-review-policy',zone_uuid,'{}','UTC',1 FROM irrigation_zones WHERE id=1"
  },
  {
   "id": "seed-managed-valve",
   "why": "Attach an owned STREGA and a conditional weekly row to exercise pause with an existing valve program.",
   "sql": "INSERT INTO devices(deveui,name,type_id,user_id,irrigation_zone_id,current_state,created_at,updated_at) VALUES ('A840410000000002','Managed valve','STREGA_VALVE',1,1,'CLOSED','2026-01-01T00:00:00.000Z','2026-01-01T00:00:00.000Z'); INSERT INTO valve_schedules(schedule_uuid,device_eui,kind,weekdays_mask,start_time,duration_minutes,timezone,condition_policy_uuid) VALUES('synthetic-review-weekly','A840410000000002','WEEKLY',127,'09:00',30,'UTC','synthetic-review-policy')"
  },
  {
   "id": "seed-case-twins",
   "why": "Two more conditional weekly schedules of the managed policy on the valve whose schedule_uuid differ only in case, the upper-case one inserted first.",
   "sql": "INSERT INTO valve_schedules(schedule_uuid,device_eui,kind,weekdays_mask,start_time,duration_minutes,timezone,condition_policy_uuid) VALUES('ABCDEF00-0000-4000-8000-0000000000C1','A840410000000002','WEEKLY',1,'05:00',10,'UTC','synthetic-review-policy');INSERT INTO valve_schedules(schedule_uuid,device_eui,kind,weekdays_mask,start_time,duration_minutes,timezone,condition_policy_uuid) VALUES('abcdef00-0000-4000-8000-0000000000c1','A840410000000002','WEEKLY',2,'05:30',10,'UTC','synthetic-review-policy');"
  },
  {
   "id": "managed-pause",
   "http": {
    "method": "PUT",
    "path": "/api/irrigation-zones/1/schedule",
    "auth": "token",
    "body": {
     "trigger_metric": "SWT_1",
     "threshold_kpa": 20,
     "enabled": false
    }
   }
  }
 ]
}
