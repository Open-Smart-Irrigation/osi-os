{
  "name": "r1-dispatch-nonhex-eui",
  "steps": [
    {
      "id": "register",
      "http": {
        "method": "POST",
        "path": "/auth/register",
        "body": {
          "username": "farmer",
          "password": "synthetic-pass-1"
        }
      }
    },
    {
      "id": "login",
      "http": {
        "method": "POST",
        "path": "/auth/login",
        "body": {
          "username": "farmer",
          "password": "synthetic-pass-1"
        }
      },
      "capture": {
        "token": "json.token"
      }
    },
    {
      "id": "create-zone",
      "http": {
        "method": "POST",
        "path": "/api/irrigation-zones",
        "auth": "token",
        "body": {
          "name": "Plan zone",
          "timezone": "Europe/Zurich"
        }
      }
    },
    {
      "id": "seed-nonhex-valves",
      "why": "STREGA rows whose deveui is not 16 hex digits (hostile/never-written state at the dispatch boundary).",
      "sql": "INSERT INTO devices(deveui,name,type_id,user_id,irrigation_zone_id,created_at,updated_at,claimed_at,current_state,target_state) VALUES ('NOTAHEXEUI000001','Nonhex valve','STREGA_VALVE',1,1,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','CLOSED','CLOSED'),('ABC123','Short valve','STREGA_VALVE',1,1,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','CLOSED','CLOSED'),('A84041000000000','Fifteen hex valve','STREGA_VALVE',1,1,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','CLOSED','CLOSED');"
    },
    {
      "id": "open-nonhex",
      "http": {
        "method": "POST",
        "path": "/api/valve/NOTAHEXEUI000001",
        "auth": "token",
        "body": {
          "action": "OPEN_FOR_DURATION",
          "duration_minutes": 5
        }
      }
    },
    {
      "id": "close-nonhex",
      "http": {
        "method": "POST",
        "path": "/api/valve/NOTAHEXEUI000001",
        "auth": "token",
        "body": {
          "action": "CLOSE"
        }
      }
    },
    {
      "id": "timed-close-nonhex",
      "http": {
        "method": "POST",
        "path": "/api/valve/NOTAHEXEUI000001",
        "auth": "token",
        "body": {
          "action": "CLOSE_FOR_DURATION",
          "duration_minutes": 5
        }
      }
    },
    {
      "id": "open-short",
      "http": {
        "method": "POST",
        "path": "/api/valve/ABC123",
        "auth": "token",
        "body": {
          "action": "OPEN_FOR_DURATION",
          "duration_minutes": 5
        }
      }
    },
    {
      "id": "open-fifteen",
      "http": {
        "method": "POST",
        "path": "/api/valve/A84041000000000",
        "auth": "token",
        "body": {
          "action": "OPEN_FOR_DURATION",
          "duration_minutes": 5
        }
      }
    },
    {
      "id": "seed-once-nonhex",
      "why": "A due ONCE schedule on the non-hex valve.",
      "sql": "INSERT INTO valve_schedules(schedule_uuid,device_eui,kind,fire_at,duration_minutes,timezone,enabled,once_state) VALUES ('ceaa2200-0000-4000-8000-0000000000a1','NOTAHEXEUI000001','ONCE',strftime('%Y-%m-%dT%H:%M:00.000Z','now','-1 minute'),7,'Europe/Zurich',1,'PENDING');"
    },
    {
      "id": "once-tick",
      "timer": "valve-once-tick"
    },
    {
      "id": "once-tick-again",
      "timer": "valve-once-tick"
    },
    {
      "id": "valves-list",
      "http": {
        "method": "GET",
        "path": "/api/valves",
        "auth": "token"
      }
    }
  ]
}
