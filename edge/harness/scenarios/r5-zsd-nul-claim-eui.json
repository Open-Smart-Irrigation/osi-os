   "id": "register",
   "http": {
    "method": "POST",
    "path": "/auth/register",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   }
  },
  {
   "id": "login",
   "http": {
    "method": "POST",
    "path": "/auth/login",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   },
   "capture": {
    "token": "json.token"
   }
  },
  {
   "id": "claim-eui-nul-tail",
   "http": {
    "method": "POST",
    "path": "/api/devices",
    "auth": "token",
    "body": {
