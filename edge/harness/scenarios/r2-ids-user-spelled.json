{
 "name": "r2-ids-user-spelled",
 "description": "fix-ids-r2 N1: users.id 123456789012345700, the integer the token id spells. The literal gate passes; the bound lookups after it compare the double. Record legacy and --scoped.",
 "steps": [
  {
   "id": "register-farmer",
   "http": {
    "method": "POST",
    "path": "/auth/register",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   }
  },
  {
   "id": "renumber-user",
   "sql": "PRAGMA foreign_keys=OFF; UPDATE users SET id=123456789012345700 WHERE id=1"
  },
  {
   "id": "login",
   "http": {
    "method": "POST",
    "path": "/auth/login",
    "body": {
     "username": "farmer",
     "password": "synthetic-pass-1"
    }
   },
   "capture": {
    "token": "json.token"
   }
  },
  {
   "id": "zones",
   "http": {
    "method": "GET",
    "path": "/api/irrigation-zones",
    "auth": "token"
   }
  },
  {
   "id": "zone-create",
   "http": {
    "method": "POST",
    "path": "/api/irrigation-zones",
    "auth": "token",
    "body": {
     "name": "Z1",
     "timezone": "Europe/Zurich"
    }
   }
  },
  {
   "id": "devices",
   "http": {
    "method": "GET",
    "path": "/api/devices",
    "auth": "token"
   }
  },
  {
   "id": "claim",
   "http": {
    "method": "POST",
    "path": "/api/devices",
    "auth": "token",
    "body": {
     "deveui": "A840410000000011",
     "name": "Dev 11",
     "type_id": "KIWI_SENSOR",
     "appkey": "00112233445566778899AABBCCDDEEFF"
    }
   }
  },
  {
   "id": "zone-direct",
   "sql": "PRAGMA foreign_keys=OFF; INSERT INTO irrigation_zones(id,name,user_id,timezone,zone_uuid,sync_version,created_at,updated_at) VALUES (5,'Z5',123456789012345700,'UTC','0b8f6a3e-6c1a-4f61-9a43-2f1d8b3e9c55',1,'2020-01-01T00:00:00.000Z','2020-01-01T00:00:00.000Z'); INSERT INTO devices(deveui,name,type_id,user_id,irrigation_zone_id,current_state,created_at,updated_at) VALUES ('A840410000000002','Valve','STREGA_VALVE',123456789012345700,5,'CLOSED','2020-01-01T00:00:00.000Z','2020-01-01T00:00:00.000Z')"
  },
  {
   "id": "zone-rename",
   "http": {
    "method": "PUT",
    "path": "/api/irrigation-zones/5/name",
    "auth": "token",
    "body": {
     "name": "Z5b"
    }
   }
  },
  {
   "id": "device-rename",
   "http": {
    "method": "PUT",
    "path": "/api/devices/A840410000000002/name",
    "auth": "token",
    "body": {
     "name": "V2"
    }
   }
  },
  {
   "id": "valves",
   "http": {
    "method": "GET",
    "path": "/api/valves",
    "auth": "token"
   }
  },
  {
   "id": "valve-schedules",
