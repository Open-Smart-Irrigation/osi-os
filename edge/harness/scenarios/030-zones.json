    { "id": "move-zone-during-update", "why": "An AFTER UPDATE trigger changes ownership between config validation and its reload.", "sql": "CREATE TRIGGER zones_test_move_owner AFTER UPDATE OF notes ON irrigation_zones WHEN NEW.id=22 BEGIN UPDATE irrigation_zones SET user_id=2 WHERE id=22; END" },
