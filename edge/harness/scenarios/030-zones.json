    { "id": "relink-gateway", "why": "Every sync_outbox trigger is gated on sync_link_state peer_node='cloud' linked=1, and no edge route can link a gateway without a real cloud to link to; the #9 success case can only produce its outbox row with this state present.", "sql": "INSERT INTO sync_link_state(peer_node, linked, gateway_device_eui, updated_at) VALUES ('cloud', 1, '0016C001F1000001', '2026-11-23T00:00:00.000Z') ON CONFLICT(peer_node) DO UPDATE SET linked=1, gateway_device_eui=excluded.gateway_device_eui, updated_at=excluded.updated_at" },
