    { "id": "seed-zone-list-rows", "why": "Supply a schedule, calibration, zero coordinates, and devices with different owners and tombstone states. The routes that create these records are outside this slice.", "sql": "INSERT INTO users(id,username,password_hash,created_at,user_uuid,role) VALUES(2,'other','synthetic-unused','2026-11-23T00:00:00.000Z','other-user','researcher'); INSERT INTO users(id,username,password_hash,created_at,user_uuid,role,disabled_at) VALUES(3,'view','synthetic-unused','2026-11-23T00:00:00.000Z','viewer-user','viewer','2026-11-23T00:00:00.000Z'); INSERT INTO users(id,username,password_hash,created_at,user_uuid,role) VALUES(4,'admin','synthetic-unused','2026-11-23T00:00:00.000Z','admin-user','admin'); INSERT INTO users(id,username,password_hash,created_at,user_uuid) VALUES(5,'legacy','synthetic-unused','2026-11-23T00:00:00.000Z',''); INSERT INTO irrigation_zones(id,name,user_id,zone_uuid) VALUES(20,'Foreign zone',2,'other-zone'),(21,'Deleted zone',1,'deleted-zone'),(22,'Legacy zone',1,'legacy-zone'); UPDATE irrigation_zones SET deleted_at='2026-11-23T00:00:00.000Z' WHERE id=21; UPDATE irrigation_zones SET zone_uuid=NULL WHERE id=22; UPDATE irrigation_zones SET created_at='2026-01-01 00:00:00' WHERE id=20; UPDATE irrigation_zones SET created_at='2026-01-01 00:00:01' WHERE id=22; UPDATE irrigation_zones SET latitude=0,longitude=0 WHERE id=1; INSERT INTO irrigation_schedules(irrigation_zone_id,trigger_metric,threshold_kpa,duration_minutes,enabled,deleted_at,last_applied_at) VALUES(1,'SWT_AVG',45.5,15,0,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z'); INSERT INTO zone_irrigation_calibration(zone_id,measured_flow_rate_lpm,measurement_method,measured_at,created_at,updated_at) VALUES(1,12.5,'bucket','2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z'); INSERT INTO devices(deveui,name,type_id,user_id,created_at,updated_at,irrigation_zone_id,deleted_at) VALUES('A840410000000001','Owned','KIWI_SENSOR',1,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z',1,NULL),('A840410000000002','Foreign','KIWI_SENSOR',2,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z',1,NULL),('A840410000000003','Deleted','KIWI_SENSOR',1,'2026-11-23T00:00:00.000Z','2026-11-23T00:00:00.000Z',1,'2026-11-23T00:00:00.000Z')" },
