  "acceptanceCases": [
    {"id": "same-time-cross-device", "expectation": "same timestamps remain in separate physical source series"},
    {"id": "edge-newer-invalid-duplicate", "expectation": "highest device_data.id wins before validity filtering; raw evidence retains both rows"},
    {"id": "zero-and-high", "expectation": "0 and finite high values remain valid measurements"},
    {"id": "all-empty-source", "expectation": "each selected source has null buckets and no invented values"},
    {"id": "source-channel-eligibility", "expectation": "unsupported channels and ineligible source/device combinations are excluded"},
    {"id": "equal-name-and-depth", "expectation": "same labels and depth do not merge source identities"},
    {"id": "unauthorized-scope", "expectation": "a device outside the authorized account/gateway/zone never appears"},
    {"id": "resolution-matrix", "levels": ["raw", "15m", "hourly", "daily", "weekly"], "expectation": "every level preserves source identity"},
    {"id": "missing-15m-in-hour", "expectation": "one missing 15m report is a null 15m bucket, not an empty hour"},
    {"id": "retained-only-daily", "expectation": "a per-device daily rollup can render without a retained raw row"},
    {"id": "season-request", "expectation": "season requests preserve source identity through weekly reduction"},
    {"id": "moved-source", "expectation": "current authorized metadata labels history without rewriting physical identity"},
    {"id": "unaligned-boundary", "expectation": "partial request boundaries retain the host's actual covered intervals"},
    {"id": "local-dst-day", "expectation": "edge daily buckets follow the farm timezone across a 23/25-hour day"},
    {"id": "slow-reporter", "expectation": "sparse reports keep null gaps; smooth visual bridging is deferred"}
