    {
      "id": "r8-open-in-first-receive-window",
      "basis": "requirement",
      "check": "scenario",
      "input": {
        "context": {
          "type_id": "STREGA_VALVE",
          "generation": "GEN1",
          "uplink_interval_minutes": 10,
          "duration_seconds": 180
        },
        "events": [
          {
            "type": "enqueue_accepted"
          },
          {
            "type": "receive_window_after_uplink",
            "uplink": 1,
            "downlink": "OPEN_FOR_DURATION"
          },
          {
            "type": "report",
            "position": "OPEN"
          },
          {
            "type": "report",
            "position": "CLOSED"
          }
        ]
      },
      "expected": {
        "r8_delivered_in_time": true,
        "command_sent": true,
        "observation": "observed_complete",
        "history_runs": 1,
        "history_requested_duration_seconds": 180,
        "ui_requested_duration_seconds": 180,
        "ui_reported_position": "CLOSED"
      },
      "decision": "S8"
    },
