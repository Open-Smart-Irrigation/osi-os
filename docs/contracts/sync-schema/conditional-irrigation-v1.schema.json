{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opensmartirrigation.org/contracts/conditional-irrigation-v1.schema.json",
  "title": "Conditional irrigation v1 typed contract",
  "definitions": {
    "CanonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Eui64": {
      "type": "string",
      "pattern": "^[A-F0-9]{16}$"
    },
    "Utc": {
      "type": "string",
      "format": "date-time"
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_eui",
        "channel"
      ],
      "properties": {
        "device_eui": {
          "$ref": "#/definitions/Eui64"
        },
        "channel": {
          "type": "string"
        }
      }
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "threshold_kpa",
            "sources"
          ],
          "properties": {
            "kind": {
              "const": "SWT"
            },
            "threshold_kpa": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/Source"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "threshold_percent",
            "sources"
          ],
          "properties": {
            "kind": {
              "const": "VWC"
            },
            "threshold_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/Source"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum_stress",
            "response_mode"
          ],
          "properties": {
            "kind": {
              "const": "DENDRO"
            },
            "minimum_stress": {
              "type": "string",
              "enum": [
                "mild",
                "moderate",
                "significant",
                "severe"
              ]
            },
            "response_mode": {
              "type": "string",
              "enum": [
                "fixed",
                "proportional"
              ]
            }
          }
        }
      ]
    },
    "DeliverySettings": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-F0-9]{16}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delivery_interval_minutes"
          ],
          "properties": {
            "delivery_interval_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        }
      },
      "propertyNames": {
        "pattern": "^[A-F0-9]{16}$"
      }
    },
    "Schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_uuid",
        "device_eui",
        "execution",
        "kind",
        "duration_minutes",
        "enabled",
        "detach"
      ],
      "properties": {
        "schedule_uuid": {
          "$ref": "#/definitions/CanonicalUuid"
        },
        "expected_sync_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "device_eui": {
          "$ref": "#/definitions/Eui64"
        },
        "kind": {
          "const": "WEEKLY"
        },
        "weekdays_mask": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 127
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "enabled": {
          "type": "boolean"
        },
        "execution": {
          "type": "string",
          "enum": [
            "conditional",
            "always"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "detach": {
          "type": "boolean"
        }
      }
    },
    "ScheduleCreate": {
      "allOf": [
        {
          "$ref": "#/definitions/Schedule"
        },
        {
          "type": "object",
          "required": [
            "expected_sync_version"
          ],
          "properties": {
            "expected_sync_version": {
              "type": "null"
            }
          }
        }
      ]
    },
    "ScheduleUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_uuid",
        "expected_sync_version"
      ],
      "properties": {
        "schedule_uuid": {
          "$ref": "#/definitions/CanonicalUuid"
        },
        "expected_sync_version": {
          "type": "integer",
          "minimum": 0
        },
        "device_eui": {
          "$ref": "#/definitions/Eui64"
        },
        "kind": {
          "const": "WEEKLY"
        },
        "weekdays_mask": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 127
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "enabled": {
          "type": "boolean"
        },
        "execution": {
          "type": "string",
          "enum": [
            "conditional",
            "always"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "detach": {
          "type": "boolean"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "policy_uuid",
        "zone_uuid",
        "condition",
        "timezone",
        "enabled",
        "observation_window_minutes",
        "min_interval_minutes",
        "max_daily_minutes",
        "delivery_settings",
        "effective_from",
        "sync_version",
        "deleted_at",
        "updated_at"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "policy_uuid": {
          "$ref": "#/definitions/CanonicalUuid"
        },
        "zone_uuid": {
          "$ref": "#/definitions/ZoneUuid"
        },
        "condition": {
          "type": [
            "object",
            "null"
          ],
          "oneOf": [
            {
              "$ref": "#/definitions/Condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          ]
        },
        "observation_window_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "min_interval_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "max_daily_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "delivery_settings": {
          "anyOf": [
            {
              "$ref": "#/definitions/DeliverySettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "sync_version": {
          "type": "integer",
          "minimum": 0
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "Clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted",
        "reason"
      ],
      "properties": {
        "trusted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SourceChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eligible",
        "state",
        "reason",
        "sources"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SWT",
            "VWC",
            "DENDRO"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Source"
          }
        }
      }
    },
    "Qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified",
        "reason"
      ],
      "properties": {
        "qualified": {
