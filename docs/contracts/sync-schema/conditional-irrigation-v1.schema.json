        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "effective_duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "projection_revision",
        "zone_uuid",
        "policy_uuid",
        "eligible_sources",
        "source_choices",
        "qualification",
        "next_check",
        "last_result",
        "clock",
        "as_of",
        "valid_until",
        "legacy_process_timezone"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "projection_revision": {
          "type": "integer",
          "minimum": 1
        },
        "zone_uuid": {
          "$ref": "#/definitions/ZoneUuid"
        },
        "policy_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligible_sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuntimeSourceChoice"
          }
        },
        "source_choices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SWT",
            "VWC",
            "DENDRO"
          ],
          "properties": {
            "SWT": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RuntimeSourceChoice"
              }
            },
            "VWC": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RuntimeSourceChoice"
              }
            },
            "DENDRO": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DendroSourceChoice"
              }
            }
          }
        },
        "qualification": {
          "$ref": "#/definitions/Qualification"
        },
        "next_check": {
          "type": [
            "string",
