              },
              "kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "eligible": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
