      "additionalProperties": false,
      "properties": {
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "effective_duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "observed_at": {
