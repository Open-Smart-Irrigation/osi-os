          ]
        },
        "last_result": {
          "$ref": "#/definitions/LastResult"
        },
        "clock": {
          "$ref": "#/definitions/Clock"
        },
        "as_of": {
          "type": "string"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_process_timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
