          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LastResult": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_key": {
          "type": [
            "string",
            "null"
          ]
