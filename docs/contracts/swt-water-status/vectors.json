{
  "contract": "swt-water-status-v1",
  "bands": {
    "wet_below_kpa": 20,
    "moist_through_kpa": 50,
    "min_kpa": 0,
    "max_kpa": 1000000
  },
  "implementations": {
    "osi-os web/react-gui": {
      "max_kpa": 300,
      "note": "Edge main still caps at the Chameleon range; the Tensiomark field integration moves it to the contract max."
    },
    "osi-server frontend": {
      "max_kpa": 1000000,
      "note": "SWT_DISPLAY_MAX_KPA in frontend/src/utils/swt.ts."
    }
  },
  "classify": [
    { "input": -1, "expected": null },
    { "input": -0.001, "expected": null },
    { "input": -0.0, "expected": "wet" },
    { "input": 0, "expected": "wet" },
    { "input": 0.1, "expected": "wet" },
    { "input": 19.999, "expected": "wet" },
    { "input": 19.999999999999996, "expected": "wet" },
    { "input": 20, "expected": "moist" },
    { "input": 35, "expected": "moist" },
    { "input": 50, "expected": "moist" },
    { "input": 50.00000000000001, "expected": "dry" },
    { "input": 50.001, "expected": "dry" },
    { "input": 120, "expected": "dry" },
    { "input": 300, "expected": "dry" },
    { "input": 300.001, "expected": "dry" },
    { "input": 301, "expected": "dry" },
    { "input": 4200, "expected": "dry" },
    { "input": 1000000, "expected": "dry" },
    { "input": 1000000.001, "expected": null },
    { "input": 10000000, "expected": null },
    { "input": null, "expected": null },
    { "input": "30", "expected": null },
    { "input": "", "expected": null },
    { "input": true, "expected": null },
    { "input": [30], "expected": null },
    { "input": { "kpa": 30 }, "expected": null }
  ],
  "non_json_inputs": {
    "expected": null,
    "inputs": ["undefined", "NaN", "Infinity", "-Infinity"]
  }
}
