{
  "schemaVersion": 1,
  "runtime": "docker",
  "architecture": "linux/amd64",
  "image": {
    "reference": "{{imageRepository}}@sha256:{{imageDigest}}",
    "pullPolicy": "never"
  },
  "user": "<uid>:<gid>",
  "workdir": "/workdir",
  "network": "bridge",
  "environment": {
    "HOME": "/workdir/.builder-home",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "CARGO_BUILD_JOBS": "2",
    "TZ": "UTC",
    "SOURCE_DATE_EPOCH": "<pinned-commit-time>"
  },
  "mount": {
    "type": "bind",
    "source": "<job-worktree>",
    "destination": "/workdir",
    "readOnly": false
  },
  "offlineOperationIds": ["activate-target", "copy-feed-config", "update-feeds", "install-feeds", "resolve-config", "verify-image"],
  "readOnlyOperationIds": ["verify-image"],
  "security": {
    "capDrop": ["ALL"],
    "capAdd": [],
    "devices": [],
    "sockets": [],
    "privileged": false,
    "noNewPrivileges": true,
    "pidsLimit": 4096,
    "ulimit": "nofile=1024:4096"
  },
  "operationIds": [
    "activate-target", "copy-feed-config", "update-feeds", "install-feeds", "resolve-config", "build-image", "verify-image",
    "verify-profile-parity", "verify-chameleon", "verify-db-schema", "verify-sync-flow", "verify-strega", "verify-communication",
    "check-mqtt-topics", "frontend-install", "frontend-test", "frontend-typecheck", "frontend-build", "mirror-gui"
  ]
}
