[Unit]
Description=OSI firmware image builder cleanup admission %i

[Service]
Type=oneshot
ExecStart=%h/.local/lib/osi-image-builder/selected/bin/osi-image-builder-cleanup %i
RemainAfterExit=no
KillMode=control-group
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
Environment=XDG_CONFIG_HOME=@OSI_IMAGE_BUILDER_XDG_CONFIG_HOME@
Environment=XDG_STATE_HOME=@OSI_IMAGE_BUILDER_XDG_STATE_HOME@
BindReadOnlyPaths=%h/.local/lib/osi-image-builder/selected
BindReadOnlyPaths=@OSI_IMAGE_BUILDER_CONFIG_ROOT@
BindReadOnlyPaths=@OSI_IMAGE_BUILDER_OUTPUT_ROOT_PATHS@
BindPaths=@OSI_IMAGE_BUILDER_STATE_ROOT@
BindPaths=@OSI_IMAGE_BUILDER_CLEANUP_WRITE_PATHS@
InaccessiblePaths=@OSI_IMAGE_BUILDER_REPOSITORY_PATH@
NoExecPaths=/
ExecPaths=%h/.local/lib/osi-image-builder/selected/bin/osi-image-builder-cleanup
ExecPaths=%h/.local/lib/osi-image-builder/selected/bin/osi-image-publish
ExecPaths=/usr/bin/node
ExecPaths=/usr/bin/systemctl
ExecPaths=/usr/bin/docker
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
